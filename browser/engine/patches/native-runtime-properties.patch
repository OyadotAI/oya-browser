+    if (depth >= kPrototypeDepth) return "Native prototype depth limit exceeded";
+    if (object->IsProxy()) return "Native property inspection rejects proxy prototypes";
+    v8::Local<v8::Array> keys;
+    if (!object->GetOwnPropertyNames(context, v8::ALL_PROPERTIES, v8::KeyConversionMode::kConvertToString).ToLocal(&keys))
