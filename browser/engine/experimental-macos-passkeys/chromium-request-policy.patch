+
+  bool ShouldUseBrowserPasskeyPolicy(
+      const device::CtapGetAssertionRequest&,
+      const base::flat_set<device::FidoTransportProtocol>& transports,
+      bool is_virtual) const override {
+    // Only this explicit fixture permits a virtual provider to select policy.
+    EXPECT_TRUE(is_virtual);
+    EXPECT_TRUE(transports.contains(device::FidoTransportProtocol::kHybrid));
+    return probe_->selected;
+  }
+
+  bool AuthorizeBrowserPasskeys(
+      const std::string& attempt_id,
+      bool completing,
+      const url::Origin& origin,
+      const std::string& rp_id,
+      const base::flat_set<device::FidoTransportProtocol>&,
+      base::RepeatingCallback<void(bool)> decide,
+      base::RepeatingClosure cancel) override {
+    EXPECT_EQ(origin, AuthenticatorImplTest::GetTestOrigin());
+    EXPECT_FALSE(rp_id.empty());
+    probe_->cancel_lifetime = cancel;
+    if (!completing) {
+      ++probe_->starts;
+      probe_->attempt_id = attempt_id;
+      probe_->saved_decision = decide;
+      if (!probe_->omit_start_decision)
+        decide.Run(true);
+    } else {
+      ++probe_->completions;
+      EXPECT_EQ(attempt_id, probe_->attempt_id);
