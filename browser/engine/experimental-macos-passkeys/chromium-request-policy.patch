+bool AuthenticatorCommonImpl::BrowserPasskeyAttemptCurrent(
+    RequestKey key,
+    const std::string& attempt_id) const {
+  return req_state_ && req_state_->request_key == key &&
+         req_state_->browser_passkey_attempt &&
+         req_state_->browser_passkey_attempt->id == attempt_id &&
+         req_state_->browser_passkey_attempt->Current(
+             RenderFrameHost::FromID(render_frame_host_id_));
+}
+
+void AuthenticatorCommonImpl::CancelBrowserPasskeyAttempt(
+    RequestKey key,
+    const std::string& attempt_id) {
+  if (!req_state_ || req_state_->request_key != key ||
+      !req_state_->browser_passkey_attempt ||
+      req_state_->browser_passkey_attempt->id != attempt_id)
+    return;
+  req_state_->browser_passkey_attempt->policy.Revoke();
+  OnCancelFromUI();
+}
+
+bool AuthenticatorCommonImpl::AuthorizeBrowserPasskeyAttempt(bool completing) {
+  const RequestKey key = GetRequestKey();
+  auto attempt = req_state_->browser_passkey_attempt;
+  const auto serial =
+      attempt->policy.Begin(completing ? oya::webauthn::PolicyPhase::kComplete
+                                       : oya::webauthn::PolicyPhase::kStart);
+  if (!serial || !BrowserPasskeyAttemptCurrent(key, attempt->id))
+    return false;
+  auto weak_this = weak_factory_.GetWeakPtr();
+  auto runner = base::SequencedTaskRunner::GetCurrentDefault();
+  const bool dispatched =
+      req_state_->request_delegate->AuthorizeBrowserPasskeys(
+          attempt->id, completing, req_state_->caller_origin,
+          req_state_->relying_party_id, attempt->transports,
+          base::BindRepeating(
+              [](std::shared_ptr<BrowserPasskeyAttempt> state,
+                 uint64_t dispatch,
+                 bool allowed) { state->policy.Decide(dispatch, allowed); },
+              attempt, *serial),
+          base::BindRepeating(
+              [](std::shared_ptr<BrowserPasskeyAttempt> state,
+                 scoped_refptr<base::SequencedTaskRunner> runner,
+                 base::WeakPtr<AuthenticatorCommonImpl> self, RequestKey key) {
+                if (state->cancellation_posted)
+                  return;
+                state->cancellation_posted = true;
+                state->policy.Revoke();
+                runner->PostTask(
+                    FROM_HERE,
+                    base::BindOnce(
+                        &AuthenticatorCommonImpl::CancelBrowserPasskeyAttempt,
+                        self, key, state->id));
+              },
+              attempt, runner, weak_this, key));
+  const bool current =
+      weak_this && weak_this->BrowserPasskeyAttemptCurrent(key, attempt->id);
+  return attempt->policy.Finish(*serial, dispatched, current, dispatched);
+}
