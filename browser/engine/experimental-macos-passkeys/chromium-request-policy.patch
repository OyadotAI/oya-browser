+// An attempt owns native document/window provenance and cannot be reused after
+// start-over. Retained JS callbacks hold only this tombstoned policy state.
+struct BrowserPasskeyAttempt {
+  BrowserPasskeyAttempt(
+      RenderFrameHost* frame,
+      base::flat_set<device::FidoTransportProtocol> allowed_transports)
+      : id(base::UnguessableToken::Create().ToString()),
+        browser_context(frame->GetBrowserContext()),
+        window(
+            WebContents::FromRenderFrameHost(frame)->GetTopLevelNativeWindow()),
+        transports(std::move(allowed_transports)) {
+    for (auto* current = frame; current; current = current->GetParent()) {
+      documents.push_back(current->GetWeakDocumentPtr());
+      origins.push_back(current->GetLastCommittedOrigin());
+    }
+  }
+  ~BrowserPasskeyAttempt() { Retire(); }
+
+  void Retire() {
+    policy.End();
+    cancellation_posted = true;
+    documents.clear();
+    origins.clear();
+    browser_context = nullptr;
+    window = gfx::NativeWindow();
+    if (retirement_callback)
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, std::move(retirement_callback));
+  }
+
+  bool Current(RenderFrameHost* frame) const {
+    auto* contents = frame ? WebContents::FromRenderFrameHost(frame) : nullptr;
+    if (!contents || frame->GetBrowserContext() != browser_context ||
+        contents->GetTopLevelNativeWindow() != window)
+      return false;
+    size_t index = 0;
+    for (auto* current = frame; current;
+         current = current->GetParent(), ++index) {
+      if (index >= documents.size() || !current->IsActive() ||
+          documents[index].AsRenderFrameHostIfValid() != current ||
+          current->GetLastCommittedOrigin() != origins[index])
+        return false;
+    }
+    return index == documents.size();
+  }
+
+  const std::string id;
+  raw_ptr<BrowserContext> browser_context;
+  gfx::NativeWindow window;
+  const base::flat_set<device::FidoTransportProtocol> transports;
+  std::vector<WeakDocumentPtr> documents;
+  std::vector<url::Origin> origins;
+  oya::webauthn::PolicyState policy;
+  bool cancellation_posted = false;
+  base::OnceClosure retirement_callback;
+};
