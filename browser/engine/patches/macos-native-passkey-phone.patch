+// Keep stock Chromium behavior unless Oya explicitly enables its native sheet.
+bool ShouldOfferHybrid(const CtapGetAssertionRequest& request) {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("oya-native-passkeys"))
+    return false;
+  return request.allow_list.empty() ||
+         std::ranges::any_of(request.allow_list, [](const auto& credential) {
+           return credential.transports.empty() ||
+                  credential.transports.contains(FidoTransportProtocol::kHybrid);
+         });
+}
