+/** Native drag lifecycle: renderer-owned payload, native hit testing and acknowledged drop delivery. */
+#include "shell/browser/oya_drag_controller.h"
+
+#include <cmath>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/task/single_thread_task_runner.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/browser/oya_drag_handler.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "ui/events/base_event_utils.h"
+
+namespace electron {
+namespace {
+const int kControllerKey = 0;
+constexpr int kSteps = 24;
+constexpr auto kStepTime = base::Milliseconds(16);
+constexpr auto kDeadline = base::Seconds(10);
+}
+
+v8::Local<v8::Promise> OyaDragController::Start(v8::Isolate* isolate,
+    content::WebContents* contents, const gfx::PointF& from,
+    const gfx::PointF& to) {
+  gin_helper::Promise<std::string> promise(isolate);
+  auto result = promise.GetHandle();
+  auto* prior = static_cast<OyaDragController*>(contents->GetUserData(&kControllerKey));
+  if (prior && prior->active_) {
+    promise.RejectWithErrorMessage("A native drag is already active in this tab");
+    return result;
+  }
+  auto controller = std::make_unique<OyaDragController>(contents, std::move(promise), from, to);
+  auto* owned = controller.get();
+  contents->SetUserData(&kControllerKey, std::move(controller));
+  owned->Begin();
+  return result;
+}
+
+OyaDragController::OyaDragController(content::WebContents* contents,
+    gin_helper::Promise<std::string> promise, const gfx::PointF& from,
+    const gfx::PointF& to)
+    : content::WebContentsObserver(contents), promise_(std::move(promise)),
+      from_(from), to_(to), point_(from) {}
+
+OyaDragController::~OyaDragController() {
+  if (active_) Finish("Native drag owner was destroyed");
+}
+
+void OyaDragController::Begin() {
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  document_ = frame->GetWeakDocumentPtr();
+  widget_ = content::RenderWidgetHostImpl::From(frame->GetRenderWidgetHost())->GetWeakPtr();
+  if (!Valid()) return;
+  auto bounds = widget_->GetView()->GetViewBounds();
+  gfx::RectF viewport(0, 0, bounds.width(), bounds.height());
+  if (!std::isfinite(from_.x()) || !std::isfinite(from_.y()) ||
+      !std::isfinite(to_.x()) || !std::isfinite(to_.y()) ||
+      !viewport.Contains(from_) || !viewport.Contains(to_)) {
+    Finish("Native drag coordinates must be finite and inside the owning viewport");
+    return;
+  }
+  registered_ = content::SetOyaDragHandler(web_contents(),
+      base::BindRepeating([](base::WeakPtr<OyaDragController> owner,
+          content::RenderFrameHost& source, const content::DropData& data,
+          blink::DragOperationsMask operations) {
+        return owner ? owner->Capture(source, data, operations) : true;
+      }, weak_factory_.GetWeakPtr()));
+  if (!registered_) { Finish("Native drag owner is already registered"); return; }
+  deadline_.Start(FROM_HERE, kDeadline, base::BindOnce(&OyaDragController::Finish,
+      weak_factory_.GetWeakPtr(), "Native drag timed out"));
+  HitTest(base::BindOnce(&OyaDragController::Press, weak_factory_.GetWeakPtr()));
+}
+
+bool OyaDragController::Valid() {
+  if (!active_) return false;
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  auto* contents = web_contents();
+  if (!contents || contents->IsBeingDestroyed() || !frame ||
+      frame != contents->GetPrimaryMainFrame() || !widget_ || !widget_->GetView() ||
+      !widget_->GetView()->IsShowing() || !widget_->GetView()->AccessibilityHasFocus()) {
+    Finish("Native drag lost its focused document");
+    return false;
+  }
+  return true;
+}
+
+bool OyaDragController::Capture(content::RenderFrameHost& source,
+    const content::DropData& data, blink::DragOperationsMask operations) {
+  if (!Valid()) return true;
+  if (&source != document_.AsRenderFrameHostIfValid() || data_ ||
+      !data.filenames.empty() || !data.file_system_files.empty() ||
+      !data.file_contents.empty() || data.download_metadata) {
+    source.GetRenderWidgetHost()->DragSourceSystemDragEnded();
+    Finish("Unsupported native drag source: only this tab's main-document non-file payload is supported");
+    return true;
+  }
+  data_ = data;
+  operations_ = operations;
+  widget_->FilterDropData(&*data_);
+  auto* delegate = web_contents()->GetDelegate();
+  if (delegate && !delegate->CanDragEnter(web_contents(), *data_, operations_))
+    Finish("Native drag was refused by the browser delegate");
+  return true;
+}
+
+void OyaDragController::HitTest(base::OnceClosure continuation) {
+  if (!Valid()) return;
+  auto* contents = static_cast<content::WebContentsImpl*>(web_contents());
+  auto* view = static_cast<content::RenderWidgetHostViewBase*>(widget_->GetView());
+  contents->GetRenderWidgetHostAtPointAsynchronously(view, point_,
+      base::BindOnce(&OyaDragController::HitTestDone, weak_factory_.GetWeakPtr(),
+                    std::move(continuation)));
+}
+
+void OyaDragController::HitTestDone(base::OnceClosure continuation,
+    base::WeakPtr<content::RenderWidgetHostViewBase> target,
+    std::optional<gfx::PointF> point) {
+  if (!Valid()) return;
+  if (!target || !point || target->GetRenderWidgetHost() != widget_.get()) {
+    Finish("Unsupported native drag target: crossing renderer widgets is not supported");
+    return;
+  }
+  std::move(continuation).Run();
+}
+
+void OyaDragController::Press() {
+  if (!Valid()) return;
+  SendMouse(blink::WebInputEvent::Type::kMouseMove, false);
+  pressed_ = true;
+  SendMouse(blink::WebInputEvent::Type::kMouseDown, true);
+  widget_->WaitForInputProcessed(base::BindOnce(&OyaDragController::Advance,
+                                               weak_factory_.GetWeakPtr()));
+}
+
+void OyaDragController::Advance() {
+  if (!Valid()) return;
+  if (step_ == kSteps) { Release(); return; }
+  const float fraction = static_cast<float>(++step_) / kSteps;
+  point_ = gfx::PointF(from_.x() + (to_.x() - from_.x()) * fraction,
+                      from_.y() + (to_.y() - from_.y()) * fraction);
+  HitTest(base::BindOnce(&OyaDragController::Move, weak_factory_.GetWeakPtr()));
+}
+
+void OyaDragController::Move() {
+  if (!Valid()) return;
+  if (!data_) {
+    SendMouse(blink::WebInputEvent::Type::kMouseMove, true);
+    widget_->WaitForInputProcessed(base::BindOnce(&OyaDragController::Next,
+                                                 weak_factory_.GetWeakPtr()));
+  } else if (!entered_) {
+    entered_ = true;
+    widget_->DragTargetDragEnter(*data_, point_, ScreenPoint(), operations_, 0,
+        base::BindOnce(&OyaDragController::Entered, weak_factory_.GetWeakPtr()));
+  } else { Over(); }
+}
+
+void OyaDragController::Entered(ui::mojom::DragOperation operation, bool handled) {
+  if (!Valid()) return;
+  Over();
+}
+
+void OyaDragController::Over() {
+  if (!Valid()) return;
+  widget_->DragTargetDragOver(point_, ScreenPoint(), operations_, 0,
+      base::BindOnce(&OyaDragController::Moved, weak_factory_.GetWeakPtr()));
+}
+
+void OyaDragController::Moved(ui::mojom::DragOperation operation, bool handled) {
+  if (!Valid()) return;
+  operation_ = operation;
+  data_->operation = operation;
+  data_->document_is_handling_drag = handled;
+  Next();
+}
+
+void OyaDragController::Next() {
+  if (!Valid()) return;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(FROM_HERE,
+      base::BindOnce(&OyaDragController::Advance, weak_factory_.GetWeakPtr()), kStepTime);
+}
+
+void OyaDragController::Release() {
+  if (!Valid()) return;
+  if (!data_) {
+    SendMouse(blink::WebInputEvent::Type::kMouseUp, false);
+    pressed_ = false;
+    widget_->WaitForInputProcessed(base::BindOnce(&OyaDragController::Ended,
+                                                 weak_factory_.GetWeakPtr()));
+  } else if (operation_ == ui::mojom::DragOperation::kNone ||
+             !(static_cast<int>(operation_) & static_cast<int>(operations_))) {
+    Finish("Native drop target did not accept the drag");
+  } else {
+    widget_->DragTargetDrop(*data_, point_, ScreenPoint(), 0,
+        base::BindOnce(&OyaDragController::Dropped, weak_factory_.GetWeakPtr()));
+  }
+}
+
+void OyaDragController::Dropped() {
+  if (!Valid()) return;
+  entered_ = false;
+  widget_->DragSourceEndedAt(point_, ScreenPoint(), operation_,
+      base::BindOnce(&OyaDragController::Ended, weak_factory_.GetWeakPtr()));
+}
+
+void OyaDragController::Ended() {
+  if (!Valid()) return;
+  if (data_) widget_->DragSourceSystemDragEnded();
+  ended_ = true;
+  pressed_ = false;
+  Finish("");
+}
+
+void OyaDragController::SendMouse(blink::WebInputEvent::Type type, bool held) {
+  blink::WebMouseEvent event(type, held ? blink::WebInputEvent::kLeftButtonDown : 0,
+                            ui::EventTimeForNow());
+  event.button = type == blink::WebInputEvent::Type::kMouseMove && !held
+                     ? blink::WebPointerProperties::Button::kNoButton
+                     : blink::WebPointerProperties::Button::kLeft;
+  event.click_count = type == blink::WebInputEvent::Type::kMouseMove ? 0 : 1;
+  event.SetPositionInWidget(point_);
+  event.SetPositionInScreen(ScreenPoint());
+  widget_->ForwardMouseEvent(event);
+}
+
+gfx::PointF OyaDragController::ScreenPoint() const {
+  const auto bounds = widget_->GetView()->GetViewBounds();
+  return gfx::PointF(bounds.x() + point_.x(), bounds.y() + point_.y());
+}
+
+void OyaDragController::Finish(const std::string& error) {
+  if (!active_) return;
+  active_ = false;
+  weak_factory_.InvalidateWeakPtrs();
+  deadline_.Stop();
+  if (registered_ && web_contents()) content::ClearOyaDragHandler(web_contents());
+  if (!ended_ && widget_ && widget_->GetView() && document_.AsRenderFrameHostIfValid()) {
+    if (entered_) widget_->DragTargetDragLeave(point_, ScreenPoint());
+    if (data_) {
+      widget_->DragSourceEndedAt(point_, ScreenPoint(), ui::mojom::DragOperation::kNone,
+                                 base::DoNothing());
+      widget_->DragSourceSystemDragEnded();
+    } else if (pressed_) {
+      point_ = gfx::PointF(-1, -1);
+      SendMouse(blink::WebInputEvent::Type::kMouseUp, false);
+    }
+  }
+  if (error.empty()) promise_.Resolve(std::string(data_ ? "html" : "pointer"));
+  else promise_.RejectWithErrorMessage(error);
+}
+
+void OyaDragController::DidStartNavigation(content::NavigationHandle*) {
+  Finish("Native drag cancelled by navigation");
+}
+void OyaDragController::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) {
+  Finish("Native drag renderer exited");
+}
+void OyaDragController::WebContentsDestroyed() {
+  Finish("Native drag tab was destroyed");
+}
+}  // namespace electron
