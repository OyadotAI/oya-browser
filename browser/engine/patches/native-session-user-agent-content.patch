 #include "content/public/browser/browser_context.h"
 
 #include <stddef.h>
@@ -511,4 +512,39 @@
 }
 #endif  // BUILDFLAG(IS_ANDROID)
 
+namespace {
+const char kOyaUserAgentKey = 0;
+// BrowserContext lifetime prevents policy sharing between independent sessions.
+class OyaSessionUserAgent final : public base::SupportsUserData::Data {
+ public:
+  explicit OyaSessionUserAgent(const std::string& value) : value(value) {}
+  const std::string value;
+};
+}  // namespace
+
+const std::string* GetOyaSessionUserAgent(BrowserContext* context) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!context)
+    return nullptr;
+  auto* policy = static_cast<OyaSessionUserAgent*>(
+      context->GetUserData(&kOyaUserAgentKey));
+  return policy ? &policy->value : nullptr;
+}
+
+bool SetOyaSessionUserAgent(BrowserContext* context,
+                            const std::string& user_agent) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (const auto* value = GetOyaSessionUserAgent(context))
+    return *value == user_agent;
+  context->SetUserData(&kOyaUserAgentKey,
+                      std::make_unique<OyaSessionUserAgent>(user_agent));
+  return true;
+}
+
+std::string GetUserAgentForOyaContext(BrowserContext* context) {
+  if (const auto* value = GetOyaSessionUserAgent(context))
+    return *value;
+  return GetContentClient()->browser()->GetUserAgent();
+}
+
 }  // namespace content
