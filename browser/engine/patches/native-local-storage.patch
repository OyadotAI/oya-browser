+/** Browser-owned first-party storage is restored before navigation, never injected into page code. */
+v8::Local<v8::Promise> Session::RestoreOyaLocalStorage(
+    const std::string& origin, const OyaStorageEntries& entries) {
+  auto operation = base::MakeRefCounted<OyaStorageOperation>(isolate_, entries);
+  auto promise = operation->handle();
+  operation->Start(browser_context_->GetDefaultStoragePartition(), origin);
+  return promise;
+}
+
+/** An empty import reads the native store without changing it. */
+v8::Local<v8::Promise> Session::ReadOyaLocalStorage(const std::string& origin) {
+  return RestoreOyaLocalStorage(origin, {});
 }
 
