+// Exercise the real native SystemInterface ownership path while intercepting
+// every perform/cancel action. No OS authentication UI is opened by these
+// tests.
+struct BrowserControllerTestState {
+  NSMutableArray<ASAuthorizationController*>* __strong controllers =
+      [[NSMutableArray alloc] init];
+  std::vector<NSInteger> results;
+  size_t cancellations = 0;
+  bool synchronous_terminal = false;
+};
+
+void FinishBrowserController(ASAuthorizationController* controller) {
+  auto delegate = controller.delegate;
+  [delegate
+      authorizationController:controller
+         didCompleteWithError:[NSError
+                                  errorWithDomain:ASAuthorizationErrorDomain
+                                             code:ASAuthorizationErrorFailed
+                                         userInfo:nil]];
+}
