+/** Native bounded tee preserves streaming backpressure; capture overflow never truncates the page's response. */
+#include "shell/browser/net/oya_body_tee.h"
+#include <array>
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "mojo/public/cpp/system/simple_watcher.h"
+namespace electron {
+namespace {
+constexpr size_t kChunk = 65536;
+constexpr size_t kCapture = 524288;
+constexpr size_t kConcurrent = 8;
+/** Self-owned until EOF or either pipe closes; no renderer/browser wrapper pointer is retained. */
+class BodyTee {
+ public:
+  BodyTee(mojo::ScopedDataPipeConsumerHandle source,
+          mojo::ScopedDataPipeProducerHandle sink,
+          std::shared_ptr<OyaBodyQuota> quota,
+          base::OnceCallback<void(std::string, std::string)> done)
+      : source_(std::move(source)), sink_(std::move(sink)), quota_(std::move(quota)), done_(std::move(done)),
+        readable_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL),
+        writable_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL),
+        closed_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::AUTOMATIC) {
+    ++quota_->active;
+    readable_.Watch(source_.get(), MOJO_HANDLE_SIGNAL_READABLE,
+        base::BindRepeating(&BodyTee::Read, base::Unretained(this)));
+    writable_.Watch(sink_.get(), MOJO_HANDLE_SIGNAL_WRITABLE,
+        base::BindRepeating(&BodyTee::Write, base::Unretained(this)));
+    closed_.Watch(sink_.get(), MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+        base::BindRepeating(&BodyTee::Closed, base::Unretained(this)));
+    readable_.ArmOrNotify();
+  }
+ private:
+  /** One chunk per notification bounds work and lets the normal browser event loop run. */
+  void Read(MojoResult signal) {
+    size_t count = 0;
+    const auto result = source_->ReadData(MOJO_READ_DATA_FLAG_NONE, base::span(buffer_), count);
+    if (result == MOJO_RESULT_SHOULD_WAIT) return readable_.ArmOrNotify();
+    if (result == MOJO_RESULT_FAILED_PRECONDITION) return Finish(overflow_ ? "Native response body exceeds capture limit" : "");
+    if (result != MOJO_RESULT_OK) return Finish("Native response pipe failed");
+    if (!overflow_ && bytes_.size() + count <= kCapture)
+      bytes_.append(reinterpret_cast<const char*>(buffer_.data()), count);
+    else { overflow_ = true; bytes_.clear(); }
+    offset_ = 0; size_ = count;
+    Write(MOJO_RESULT_OK);
+  }
+  /** A full downstream pipe stops upstream reads instead of accumulating unbounded chunks. */
+  void Write(MojoResult signal) {
+    size_t written = 0;
+    const auto data = base::span(buffer_).subspan(offset_, size_ - offset_);
+    const auto result = sink_->WriteData(data, MOJO_WRITE_DATA_FLAG_NONE, written);
+    if (result == MOJO_RESULT_SHOULD_WAIT) return writable_.ArmOrNotify();
+    if (result != MOJO_RESULT_OK) return Finish("Native response consumer closed");
+    offset_ += written;
+    if (offset_ < size_) writable_.ArmOrNotify();
+    else readable_.ArmOrNotify();
+  }
+  /** A canceled renderer cannot strand a tee waiting forever for its network peer. */
+  void Closed(MojoResult result) { Finish("Native response consumer closed"); }
+  /** Cancel callbacks before closing handles or invoking application code. */
+  void Finish(const std::string& error) {
+    readable_.Cancel(); writable_.Cancel(); closed_.Cancel();
+    source_.reset(); sink_.reset();
+    --quota_->active;
+    std::move(done_).Run(error.empty() ? std::move(bytes_) : std::string(), error);
+    delete this;
+  }
+  mojo::ScopedDataPipeConsumerHandle source_;
+  mojo::ScopedDataPipeProducerHandle sink_;
+  std::shared_ptr<OyaBodyQuota> quota_;
+  base::OnceCallback<void(std::string, std::string)> done_;
+  mojo::SimpleWatcher readable_, writable_, closed_;
+  std::array<uint8_t, kChunk> buffer_;
+  size_t size_ = 0, offset_ = 0;
+  bool overflow_ = false;
+  std::string bytes_;
+};
+}
+mojo::ScopedDataPipeConsumerHandle CaptureOyaBody(
+    mojo::ScopedDataPipeConsumerHandle body, std::shared_ptr<OyaBodyQuota> quota,
+    base::OnceCallback<void(std::string, std::string)> done) {
+  if (!body.is_valid()) { std::move(done).Run("", ""); return body; }
+  if (quota->active >= kConcurrent) {
+    std::move(done).Run("", "Native response capture concurrency limit exceeded"); return body;
+  }
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  if (mojo::CreateDataPipe(nullptr, producer, consumer) != MOJO_RESULT_OK) {
+    std::move(done).Run("", "Native response capture pipe unavailable"); return body;
+  }
+  new BodyTee(std::move(body), std::move(producer), std::move(quota), std::move(done));
+  return consumer;
+}
+}
