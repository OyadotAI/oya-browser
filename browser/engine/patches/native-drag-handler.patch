+/** Browser-owned drag capture after renderer payload security filtering. */
+#ifndef CONTENT_PUBLIC_BROWSER_OYA_DRAG_HANDLER_H_
+#define CONTENT_PUBLIC_BROWSER_OYA_DRAG_HANDLER_H_
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+#include "third_party/blink/public/common/page/drag_operation.h"
+namespace content {
+class WebContents;
+class RenderFrameHost;
+struct DropData;
+using OyaDragHandler = base::RepeatingCallback<bool(RenderFrameHost&, const DropData&, blink::DragOperationsMask)>;
+// One owner per contents; callbacks are never visible in a renderer or protocol.
+CONTENT_EXPORT bool SetOyaDragHandler(WebContents*, OyaDragHandler);
+CONTENT_EXPORT void ClearOyaDragHandler(WebContents*);
+}  // namespace content
+#endif
