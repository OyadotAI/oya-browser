 namespace {
 
+// Opt-ins live only in their native BrowserContext, never in application globals.
+const char kOyaClientHintsKey = 0;
+constexpr size_t kMaxOyaClientHintOrigins = 256;
+using OyaHint = network::mojom::WebClientHintsType;
+
+bool IsOyaUserAgentHint(OyaHint hint) {
+  constexpr OyaHint allowed[] = {
+      OyaHint::kUA, OyaHint::kUAArch, OyaHint::kUAPlatform, OyaHint::kUAModel,
+      OyaHint::kUAMobile, OyaHint::kUAFullVersion, OyaHint::kUAPlatformVersion,
+      OyaHint::kUABitness, OyaHint::kUAFullVersionList, OyaHint::kUAWoW64,
+      OyaHint::kUAFormFactors};
+  return std::find(std::begin(allowed), std::end(allowed), hint) != std::end(allowed);
+}
+
+class OyaClientHints final : public base::SupportsUserData::Data,
+                            public content::ClientHintsControllerDelegate {
+ public:
+  explicit OyaClientHints(electron::ElectronBrowserContext* context)
+      : context_(context) {}
+  network::NetworkQualityTracker* GetNetworkQualityTracker() override { return nullptr; }
+  blink::UserAgentMetadata GetUserAgentMetadata() override {
+    return content::GetUserAgentMetadataForOyaContext(context_);
+  }
+  bool IsJavaScriptAllowed(const GURL& url, content::RenderFrameHost*) override {
+    // Content additionally enforces per-frame WebPreferences before sending or persisting hints.
+    return url.SchemeIsHTTPOrHTTPS() && network::IsUrlPotentiallyTrustworthy(url);
+  }
+  void GetAllowedClientHintsFromSource(const url::Origin& origin,
+                                      blink::EnabledClientHints* hints) override {
+    if (!IsJavaScriptAllowed(origin.GetURL(), nullptr))
+      return;
+    const auto found = origins_.find(origin);
+    if (found != origins_.end())
+      *hints = found->second;
+    for (auto hint : additional_)
+      hints->SetIsEnabled(hint, true);
+  }
+  void PersistClientHints(const url::Origin& origin, content::RenderFrameHost* parent,
+                          const std::vector<OyaHint>& hints) override {
+    if (parent || origin.opaque() || !IsJavaScriptAllowed(origin.GetURL(), parent))
+      return;
+    blink::EnabledClientHints enabled;
+    for (auto hint : hints)
+      if (IsOyaUserAgentHint(hint)) enabled.SetIsEnabled(hint, true);
+    if (enabled.GetEnabledHints().empty()) {
+      origins_.erase(origin);
+      return;
+    }
+    // Refuse new opt-ins at the bound rather than retaining an unbounded origin history.
+    if (!origins_.contains(origin) && origins_.size() >= kMaxOyaClientHintOrigins)
+      return;
+    origins_[origin] = enabled;
+  }
+  void SetAdditionalClientHints(const std::vector<OyaHint>& hints) override {
+    additional_.clear();
+    for (auto hint : hints)
+      if (IsOyaUserAgentHint(hint) &&
+          std::find(additional_.begin(), additional_.end(), hint) == additional_.end())
+        additional_.push_back(hint);
+  }
+  void ClearAdditionalClientHints() override { additional_.clear(); }
+  void SetMostRecentMainFrameViewportSize(const gfx::Size& size) override { viewport_ = size; }
+  gfx::Size GetMostRecentMainFrameViewportSize() override { return viewport_; }
+  void Clear() { origins_.clear(); additional_.clear(); }
+ private:
+  const raw_ptr<electron::ElectronBrowserContext> context_;
+  std::map<url::Origin, blink::EnabledClientHints> origins_;
+  std::vector<OyaHint> additional_;
+  gfx::Size viewport_;
+};
