+// Each browser wrapper owns one native associated interface for its exact renderer frame.
+v8::Local<v8::Promise> WebFrameMain::RunOyaRuntime(v8::Isolate* isolate,
+    const std::string& owner, const std::string& context, const std::string& operation,
+    base::Value parameters) {
+  gin_helper::Promise<base::Value> promise(isolate);
+  auto result = promise.GetHandle();
+  if (render_frame_disposed_) {
+    promise.RejectWithErrorMessage("Native runtime frame was disposed");
+    return result;
+  }
+  if (oya_runtime_.is_bound() && !oya_runtime_.is_connected()) oya_runtime_.reset();
+  if (!oya_runtime_.is_bound())
+    render_frame_host()->GetRemoteAssociatedInterfaces()->GetInterface(&oya_runtime_);
+  base::MakeRefCounted<OyaFrameExecution>(render_frame_host(), std::move(promise))->Runtime(
+      oya_runtime_.get(), owner, context, operation, std::move(parameters));
+  return result;
+}
