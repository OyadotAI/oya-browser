+/** One bounded Mojo request owns its storage area until all native replies settle. */
+class OyaStorageOperation : public base::RefCounted<OyaStorageOperation> {
+ public:
+  OyaStorageOperation(v8::Isolate* isolate, OyaStorageEntries restore)
+      : promise_(isolate), restore_(std::move(restore)) {}
+  v8::Local<v8::Promise> handle() { return promise_.GetHandle(); }
+  void Start(content::StoragePartition* partition, const std::string& origin) {
+    const auto parsed = url::Origin::Create(GURL(origin));
+    if (parsed.opaque() || !GURL(origin).SchemeIsHTTPOrHTTPS() || parsed.Serialize() != origin ||
+        !ValidOyaStorage(restore_)) {
+      Fail("Invalid native localStorage origin or entries");
+      return;
+    }
+    partition->GetLocalStorageControl()->BindStorageArea(
+        blink::StorageKey::CreateFirstParty(parsed), area_.BindNewPipeAndPassReceiver());
+    area_.set_disconnect_handler(base::BindOnce(&OyaStorageOperation::Fail,
+        base::RetainedRef(this), "Native localStorage service disconnected"));
+    timer_.Start(FROM_HERE, kOyaStorageTimeout, base::BindOnce(&OyaStorageOperation::Fail,
+        base::RetainedRef(this), "Native localStorage operation timed out"));
+    area_->GetAll(mojo::NullRemote(), base::BindOnce(&OyaStorageOperation::Read,
+                                                   base::RetainedRef(this)));
+  }
+ private:
+  friend class base::RefCounted<OyaStorageOperation>;
+  ~OyaStorageOperation() = default;
+  void Read(std::vector<blink::mojom::KeyValuePtr> values) {
+    if (!values.empty() || restore_.empty()) return Resolve(std::move(values));
+    PutNext();
+  }
+  void PutNext() {
+    if (next_ == restore_.size()) {
+      area_->GetAll(mojo::NullRemote(), base::BindOnce(&OyaStorageOperation::Resolve,
+                                                     base::RetainedRef(this)));
+      return;
+    }
+    const auto& entry = restore_[next_++];
+    area_->Put(EncodeOyaStorage(entry[0]), EncodeOyaStorage(entry[1]), std::nullopt, nullptr,
+               base::BindOnce(&OyaStorageOperation::Written, base::RetainedRef(this)));
+  }
+  void Written(bool success) {
+    if (!success) return Fail("Native localStorage restore was rejected");
+    PutNext();
+  }
+  void Resolve(std::vector<blink::mojom::KeyValuePtr> values) {
+    if (settled_) return;
+    if (values.size() > kOyaStorageMaxEntries) return Fail("Native localStorage snapshot exceeds limit");
+    OyaStorageEntries result;
+    size_t units = 0;
+    for (const auto& value : values) {
+      auto key = DecodeOyaStorage(value->key), text = DecodeOyaStorage(value->value);
+      if (!key || !text) return Fail("Native localStorage encoding is unsupported");
+      units += key->size() + text->size();
+      if (units > kOyaStorageMaxUnits) return Fail("Native localStorage snapshot exceeds limit");
+      result.push_back({std::move(*key), std::move(*text)});
+    }
+    settled_ = true;
+    timer_.Stop();
+    area_.reset();
+    promise_.Resolve(result);
+  }
+  void Fail(const std::string& message) {
+    if (settled_) return;
+    settled_ = true;
+    timer_.Stop();
+    area_.reset();
+    promise_.RejectWithErrorMessage(message);
+  }
+  gin_helper::Promise<OyaStorageEntries> promise_;
+  OyaStorageEntries restore_;
+  mojo::Remote<blink::mojom::StorageArea> area_;
+  base::OneShotTimer timer_;
+  size_t next_ = 0;
+  bool settled_ = false;
+};
+}  // namespace
