{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.OyadotAI/oya-browser",
  "title": "Oya Browser",
  "description": "Real Chrome for agents. Install the desktop app, click Connect; this remote is the cloud fallback.",
  "repository": {
    "url": "https://github.com/OyadotAI/oya-browser",
    "source": "github"
  },
  "websiteUrl": "https://oyabrowser.com",
  "icons": [
    {
      "src": "https://oyabrowser.com/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "128x128"
      ]
    }
  ],
  "version": "1.0.224",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://oyabrowser.com/mcp/pool",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Oya API key from oyabrowser.com, sent as a bearer token",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "Oya API key",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
