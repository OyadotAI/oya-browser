+namespace {
+
+// Native discovery seam: reports readiness asynchronously without touching an
+// authenticator, adapter, credential store or OS authentication UI.
+class HybridProbeDiscovery : public FidoDiscoveryBase {
+ public:
+  HybridProbeDiscovery(FidoTransportProtocol role,
+                       bool os_managed,
+                       std::shared_ptr<size_t> starts,
+                       bool success = true)
+      : FidoDiscoveryBase(role),
+        os_managed_(os_managed),
+        starts_(std::move(starts)),
+        success_(success) {}
+  void Start() override {
+    ++*starts_;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&HybridProbeDiscovery::Ready,
+                                  weak_factory_.GetWeakPtr()));
+  }
+  bool IsOsManagedHybrid() const override { return os_managed_; }
+
+ private:
+  void Ready() { observer()->DiscoveryStarted(this, success_); }
+  const bool os_managed_;
+  const std::shared_ptr<size_t> starts_;
+  const bool success_;
+  base::WeakPtrFactory<HybridProbeDiscovery> weak_factory_{this};
+};
+
+// Init from the derived constructor so virtual dispatch intercepts the entire
+// browser-only Bluetooth metadata/probe/manager scope, not merely its last
+// task.
+class HybridProbeHandler : public FidoRequestHandlerBase {
+ public:
+  HybridProbeHandler(test::FakeFidoDiscoveryFactory* factory,
+                     std::vector<std::unique_ptr<FidoDiscoveryBase>> additional,
+                     base::flat_set<FidoTransportProtocol> allowed) {
+    InitDiscoveries(factory, std::move(additional), std::move(allowed), false);
+    Start();
+  }
+  size_t browser_ble_setups = 0;
+
+ private:
+  void DispatchRequest(FidoAuthenticator*) override {}
+  void StartBrowserBleDiscovery() override { ++browser_ble_setups; }
+};
+
+}  // namespace
