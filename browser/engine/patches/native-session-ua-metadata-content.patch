+namespace {
+const char kOyaUserAgentMetadataKey = 0;
+// Immutable native metadata shares the owning BrowserContext's exact lifetime.
+class OyaSessionUserAgentMetadata final : public base::SupportsUserData::Data {
+ public:
+  explicit OyaSessionUserAgentMetadata(const blink::UserAgentMetadata& value)
+      : value(value) {}
+  const blink::UserAgentMetadata value;
+};
+}  // namespace
+
+const blink::UserAgentMetadata* GetOyaSessionUserAgentMetadata(BrowserContext* context) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!context)
+    return nullptr;
+  auto* policy = static_cast<OyaSessionUserAgentMetadata*>(
+      context->GetUserData(&kOyaUserAgentMetadataKey));
+  return policy ? &policy->value : nullptr;
+}
+
+bool SetOyaSessionUserAgentMetadata(BrowserContext* context,
+                                  const blink::UserAgentMetadata& metadata) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (const auto* value = GetOyaSessionUserAgentMetadata(context))
+    return *value == metadata;
+  context->SetUserData(&kOyaUserAgentMetadataKey,
+                      std::make_unique<OyaSessionUserAgentMetadata>(metadata));
+  return true;
+}
+
+blink::UserAgentMetadata GetUserAgentMetadataForOyaContext(BrowserContext* context) {
+  if (const auto* value = GetOyaSessionUserAgentMetadata(context))
+    return *value;
+  return GetContentClient()->browser()->GetUserAgentMetadata();
+}
+
 }  // namespace content
