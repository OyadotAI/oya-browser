+/** Browser-owned, document-scoped native drag transport; no protocol or DOM event synthesis. */
+#ifndef ELECTRON_SHELL_BROWSER_OYA_DRAG_CONTROLLER_H_
+#define ELECTRON_SHELL_BROWSER_OYA_DRAG_CONTROLLER_H_
+
+#include <optional>
+#include <string>
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/timer/timer.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/common/drop_data.h"
+#include "shell/common/gin_helper/promise.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/public/common/page/drag_operation.h"
+#include "ui/base/dragdrop/mojom/drag_drop_types.mojom.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace content {
+class RenderWidgetHostImpl;
+class RenderWidgetHostViewBase;
+}
+
+namespace electron {
+/** Owns one gesture in one visible document; unsupported frame targets fail closed. */
+class OyaDragController : public content::WebContentsObserver,
+                          public base::SupportsUserData::Data {
+ public:
+  static v8::Local<v8::Promise> Start(v8::Isolate* isolate,
+      content::WebContents* contents, const gfx::PointF& from,
+      const gfx::PointF& to);
+  OyaDragController(content::WebContents* contents,
+      gin_helper::Promise<std::string> promise, const gfx::PointF& from,
+      const gfx::PointF& to);
+  ~OyaDragController() override;
+
+ private:
+  void Begin();
+  bool Valid();
+  bool Capture(content::RenderFrameHost& source, const content::DropData& data,
+               blink::DragOperationsMask operations);
+  void HitTest(base::OnceClosure continuation);
+  void HitTestDone(base::OnceClosure continuation,
+      base::WeakPtr<content::RenderWidgetHostViewBase> target,
+      std::optional<gfx::PointF> point);
+  void Press();
+  void Advance();
+  void Move();
+  void Entered(ui::mojom::DragOperation operation, bool handled);
+  void Over();
+  void Moved(ui::mojom::DragOperation operation, bool handled);
+  void Next();
+  void Release();
+  void Dropped();
+  void Ended();
+  void SendMouse(blink::WebInputEvent::Type type, bool held);
+  gfx::PointF ScreenPoint() const;
+  void Finish(const std::string& error);
+  void DidStartNavigation(content::NavigationHandle* navigation) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus status) override;
+  void WebContentsDestroyed() override;
+
+  gin_helper::Promise<std::string> promise_;
+  content::WeakDocumentPtr document_;
+  base::WeakPtr<content::RenderWidgetHostImpl> widget_;
+  gfx::PointF from_, to_, point_;
+  std::optional<content::DropData> data_;
+  blink::DragOperationsMask operations_ = blink::kDragOperationNone;
+  ui::mojom::DragOperation operation_ = ui::mojom::DragOperation::kNone;
+  int step_ = 0;
+  bool active_ = true;
+  bool pressed_ = false;
+  bool entered_ = false;
+  bool ended_ = false;
+  bool registered_ = false;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<OyaDragController> weak_factory_{this};
+};
+}  // namespace electron
+#endif
