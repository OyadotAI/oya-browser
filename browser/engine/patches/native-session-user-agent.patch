+void WebContents::SetUserAgentFromApi(gin_helper::ErrorThrower thrower,
+                                      const std::string& user_agent) {
+  const auto* installed = content::GetOyaSessionUserAgent(web_contents()->GetBrowserContext());
+  if (installed && *installed != user_agent) {
+    thrower.ThrowError("Native session owns User-Agent");
+    return;
+  }
+  SetUserAgent(user_agent);
