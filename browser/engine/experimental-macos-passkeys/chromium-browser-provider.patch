+// Owns the experimental controller independently of request and delegate
+// lifetimes. The single quarantined operation survives caller cancellation.
+class API_AVAILABLE(macos(13.3)) BrowserAssertionSystem
+    : public base::RefCounted<BrowserAssertionSystem> {
+ public:
+  explicit BrowserAssertionSystem(
+      std::optional<BrowserAssertionTestHooks> hooks = std::nullopt)
+      : test_hooks_(std::move(hooks)) {}
+
+  base::OnceClosure Start(
+      NSWindow* window,
+      CtapGetAssertionRequest request,
+      FidoTransportProtocol discovery_role,
+      SystemInterface::LargeBlobAssertionInputs large_blob_inputs,
+      base::RepeatingCallback<bool()> authorized,
+      base::OnceCallback<void(ASAuthorization*, NSError*)> callback) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    scoped_refptr<BrowserAssertionSystem> keep_alive(this);
+    if (!authorized || !authorized.Run() ||
+        (!test_hooks_ && (!window || !ProcessHasEntitlement())) ||
+        (discovery_role != FidoTransportProtocol::kInternal &&
+         discovery_role != FidoTransportProtocol::kHybrid) ||
+        !HasHybridCredential(request) || browser_operation_) {
+      std::move(callback).Run(nil, BrowserAssertionError());
+      return base::OnceClosure();
+    }
+    const auto token = browser_owner_.Acquire();
+    if (!token) {
+      std::move(callback).Run(nil, BrowserAssertionError());
+      return base::OnceClosure();
+    }
+    auto* value_request = BuildAssertionRequest(
+        request, large_blob_inputs, true,
+        discovery_role == FidoTransportProtocol::kInternal);
+    if (!value_request) {
+      browser_owner_.Complete(*token);
+      std::move(callback).Run(nil, BrowserAssertionError());
+      return base::OnceClosure();
+    }
+    auto operation = std::make_unique<BrowserOperation>();
+    operation->controller = [[ICloudKeychainGetController alloc]
+        initWithAuthorizationRequests:@[ value_request ]];
+    if (!operation->controller) {
+      browser_owner_.Complete(*token);
+      std::move(callback).Run(nil, BrowserAssertionError());
+      return base::OnceClosure();
+    }
+    if (!authorized.Run()) {
+      browser_owner_.Complete(*token);
+      std::move(callback).Run(nil, BrowserAssertionError());
+      return base::OnceClosure();
+    }
+    [operation->controller setRequest:std::move(request)];
+    operation->delegate = [[OyaBrowserAssertionDelegate alloc] init];
+    [operation->delegate
+        setCallback:base::BindOnce(&BrowserAssertionSystem::BrowserTerminal,
+                                   base::RetainedRef(this), *token,
+                                   std::move(callback))];
+    operation->presentation = [[OyaBrowserPresentationDelegate alloc] init];
+    operation->presentation.window = window;
+    operation->controller.delegate = operation->delegate;
+    operation->controller.presentationContextProvider = operation->presentation;
+    auto cancel =
+        base::BindOnce(&BrowserAssertionSystem::CancelBrowserOperation,
+                       weak_factory_.GetWeakPtr(), *token);
+    browser_operation_ = std::move(operation);
+    if (test_hooks_)
+      test_hooks_->perform.Run(browser_operation_->controller);
+    else
+      [browser_operation_->controller performRequests];
+    // A synchronous terminal callback may already have retired this token.
+    return cancel;
+  }
+
+  bool busy() const {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    return browser_owner_.busy();
+  }
+
+ private:
+  friend class base::RefCounted<BrowserAssertionSystem>;
+  ~BrowserAssertionSystem() = default;
+  // Cancellation does not release the slot, even if the request has timed out.
+  void CancelBrowserOperation(uint64_t token) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!browser_owner_.Revoke(token) || !browser_operation_)
+      return;
+    if (test_hooks_)
+      test_hooks_->cancel.Run(browser_operation_->controller);
+    else
+      [browser_operation_->controller cancel];
+  }
+
+  void BrowserTerminal(
+      uint64_t token,
+      base::OnceCallback<void(ASAuthorization*, NSError*)> callback,
+      ASAuthorization* authorization,
+      NSError* error) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!browser_owner_.IsCurrent(token) || !browser_operation_)
+      return;
+    const bool deliver = browser_owner_.AllowsResult(token);
+    auto terminal_operation = std::move(browser_operation_);
+    browser_owner_.Complete(token);
+    // The old operation's strong references stay on this stack across callback
+    // reentrancy. Never consult or clear new operation storage after Run().
+    if (deliver)
+      std::move(callback).Run(authorization, error);
+    else
+      std::move(callback).Run(
+          nil, BrowserAssertionError(ASAuthorizationErrorCanceled));
+  }
+
+  // Exactly one native operation owns all of its Objective-C storage.
+  struct BrowserOperation {
+    ICloudKeychainGetController* __strong controller = nil;
+    OyaBrowserAssertionDelegate* __strong delegate = nil;
+    OyaBrowserPresentationDelegate* __strong presentation = nil;
+  };
+  const std::optional<BrowserAssertionTestHooks> test_hooks_;
+  oya::webauthn::ControllerLease browser_owner_;
+  std::unique_ptr<BrowserOperation> browser_operation_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<BrowserAssertionSystem> weak_factory_{this};
+};
