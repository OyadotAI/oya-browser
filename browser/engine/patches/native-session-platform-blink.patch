 namespace blink {
+namespace {
+constexpr std::array kOyaPlatforms = {std::string_view(), std::string_view("MacIntel"),
+                                     std::string_view("Win32"), std::string_view("Linux x86_64")};
+std::atomic<unsigned> oya_platform_index{0};
+}  // namespace
+
+void SetOyaNavigatorPlatform(std::string_view platform) {
+  const auto found = std::find(kOyaPlatforms.begin(), kOyaPlatforms.end(), platform);
+  CHECK(found != kOyaPlatforms.end() && found != kOyaPlatforms.begin());
+  unsigned empty = 0;
+  CHECK(oya_platform_index.compare_exchange_strong(
+      empty, static_cast<unsigned>(found - kOyaPlatforms.begin()), std::memory_order_relaxed));
+}
+
+String GetOyaNavigatorPlatform() {
+  return String::FromUtf8(kOyaPlatforms[oya_platform_index.load(std::memory_order_relaxed)]);
+}
