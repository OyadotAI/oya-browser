+/** A session-owned observer is tied to one first-party storage key, never a renderer world. */
+class OyaStorageWatch final : public blink::mojom::StorageAreaObserver {
+ public:
+  OyaStorageWatch(v8::Isolate* isolate, content::StoragePartition* partition, const url::Origin& origin,
+                  base::RepeatingCallback<void(bool)> changed)
+      : ready_(isolate), changed_(std::move(changed)), receiver_(this) {
+    partition->GetLocalStorageControl()->BindStorageArea(
+        blink::StorageKey::CreateFirstParty(origin), area_.BindNewPipeAndPassReceiver());
+    area_.set_disconnect_handler(base::BindOnce(&OyaStorageWatch::Disconnected,
+                                               base::Unretained(this)));
+    area_->GetAll(receiver_.BindNewPipeAndPassRemote(), base::BindOnce(&OyaStorageWatch::Ready, base::Unretained(this)));
+    receiver_.set_disconnect_handler(base::BindOnce(&OyaStorageWatch::Disconnected,
+                                                   base::Unretained(this)));
+    timer_.Start(FROM_HERE, base::Seconds(15), base::BindOnce(&OyaStorageWatch::Disconnected,
+                                                          base::Unretained(this)));
+  }
+  ~OyaStorageWatch() override { if (!initialized_) ready_.RejectWithErrorMessage("Native storage watch closed"); }
+  v8::Local<v8::Promise> handle() { return ready_.GetHandle(); }
+  void KeyChanged(const std::vector<uint8_t>&, const std::vector<uint8_t>&,
+                  const std::optional<std::vector<uint8_t>>&,
+                  blink::mojom::StorageAreaSourcePtr) override { changed_.Run(true); }
+  void KeyChangeFailed(const std::vector<uint8_t>&,
+                       blink::mojom::StorageAreaSourcePtr) override {}
+  void KeyDeleted(const std::vector<uint8_t>&,
+                  const std::optional<std::vector<uint8_t>>&,
+                  blink::mojom::StorageAreaSourcePtr) override { changed_.Run(true); }
+  void AllDeleted(bool, blink::mojom::StorageAreaSourcePtr) override { changed_.Run(true); }
+  void ShouldSendOldValueOnMutations(bool) override {}
+ private:
+  void Ready(std::vector<blink::mojom::KeyValuePtr>) { initialized_ = true; timer_.Stop(); ready_.Resolve(); }
+  void Disconnected() {
+    initialized_ = true;
+    timer_.Stop();
+    ready_.RejectWithErrorMessage("Native storage observer disconnected");
+    auto notify = changed_;
+    area_.reset(); receiver_.reset();
+    notify.Run(false);
+  }
+  bool initialized_ = false;
+  base::OneShotTimer timer_;
+  gin_helper::Promise<void> ready_;
+  base::RepeatingCallback<void(bool)> changed_;
+  mojo::Remote<blink::mojom::StorageArea> area_;
+  mojo::Receiver<blink::mojom::StorageAreaObserver> receiver_;
+};
+
+/** Notifications carry only an origin; the authorized owner reads a bounded snapshot separately. */
+v8::Local<v8::Promise> Session::WatchOyaLocalStorage(const std::string& origin) {
+  const auto parsed = url::Origin::Create(GURL(origin));
+  if (oya_storage_watches_.contains(origin)) return oya_storage_watches_[origin]->handle();
+  if (parsed.opaque() || !GURL(origin).SchemeIsHTTPOrHTTPS() || parsed.Serialize() != origin ||
+      oya_storage_watches_.size() >= 1024) {
+    gin_helper::Promise<void> failed(isolate_);
+    auto handle = failed.GetHandle();
+    failed.RejectWithErrorMessage("Invalid or excessive native storage watch");
+    return handle;
+  }
+  auto watch = std::make_unique<OyaStorageWatch>(isolate_,
+      browser_context_->GetDefaultStoragePartition(), parsed,
+      base::BindRepeating([](Session* self, const std::string& origin, bool available) {
+        self->Emit("oya-local-storage-changed", origin, available);
+      }, base::Unretained(this), origin));
+  auto handle = watch->handle();
+  oya_storage_watches_[origin] = std::move(watch);
+  return handle;
+}
+
+/** Removing the watcher closes both Mojo pipes and stops further notifications for that origin. */
+void Session::UnwatchOyaLocalStorage(const std::string& origin) {
+  oya_storage_watches_.erase(origin);
+}
