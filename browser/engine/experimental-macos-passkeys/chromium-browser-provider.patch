+class API_AVAILABLE(macos(13.3)) BrowserControllerHarness {
+ public:
+  BrowserControllerHarness() {
+    BrowserAssertionTestHooks hooks;
+    hooks.perform = base::BindRepeating(
+        [](std::shared_ptr<BrowserControllerTestState> state,
+           ASAuthorizationController* controller) {
+          [state->controllers addObject:controller];
+          if (state->synchronous_terminal) {
+            state->synchronous_terminal = false;
+            FinishBrowserController(controller);
+          }
+        },
+        state);
+    hooks.cancel = base::BindRepeating(
+        [](std::shared_ptr<BrowserControllerTestState> state,
+           ASAuthorizationController*) { ++state->cancellations; },
+        state);
+    system = NewNativeSystemInterfaceForTesting(std::move(hooks));
+  }
+  ~BrowserControllerHarness() {
+    for (ASAuthorizationController* controller in state->controllers)
+      FinishBrowserController(controller);
+  }
+  base::OnceClosure Start(
+      CtapGetAssertionRequest request = CtapGetAssertionRequest("rp.id", "{}"),
+      base::RepeatingCallback<bool()> authorized = base::BindRepeating([] {
+        return true;
+      })) {
+    return system->GetBrowserAssertion(
+        nil, std::move(request), FidoTransportProtocol::kInternal, {},
+        std::move(authorized),
+        base::BindOnce(
+            [](std::shared_ptr<BrowserControllerTestState> state,
+               ASAuthorization*, NSError* error) {
+              state->results.push_back(error ? error.code : 0);
+            },
+            state));
+  }
+  std::shared_ptr<BrowserControllerTestState> state =
+      std::make_shared<BrowserControllerTestState>();
+  scoped_refptr<SystemInterface> system;
+};
