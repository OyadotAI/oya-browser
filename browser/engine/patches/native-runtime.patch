+        base::BindOnce(&OyaFrameExecution::RuntimeComplete, weak_factory_.GetWeakPtr()),
+        base::BindOnce(&OyaFrameExecution::Cancel, weak_factory_.GetWeakPtr(), kContextGone)));
+  }
