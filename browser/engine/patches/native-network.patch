+/** Bounded native response copying without refetching, page instrumentation, or debugger access. */
+#ifndef ELECTRON_SHELL_BROWSER_NET_OYA_BODY_TEE_H_
+#define ELECTRON_SHELL_BROWSER_NET_OYA_BODY_TEE_H_
+#include <memory>
+#include <string>
+#include "base/functional/callback.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+namespace electron {
+/** Shared quota survives session disposal until its native pipes finish. */
+struct OyaBodyQuota { size_t active = 0; };
+/** Transfer the original pipe unchanged when a bounded tee cannot be allocated. */
+mojo::ScopedDataPipeConsumerHandle CaptureOyaBody(
+    mojo::ScopedDataPipeConsumerHandle body,
+    std::shared_ptr<OyaBodyQuota> quota,
+    base::OnceCallback<void(std::string, std::string)> done);
+}
+#endif
