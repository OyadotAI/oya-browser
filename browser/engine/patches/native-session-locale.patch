+// Set ICU before any web script or worker isolate starts; existing main isolates
+// discard their cached defaults through V8's native notification APIs.
+void ApplyOyaSessionLocale() {
+  const auto tag = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "oya-session-locale");
+  if (tag.empty()) return;
+  UErrorCode status = U_ZERO_ERROR;
+  const auto locale = icu::Locale::forLanguageTag(tag, status);
+  CHECK(U_SUCCESS(status) && !locale.isBogus() && *locale.getLanguage());
+  icu::Locale::setDefault(locale, status);
+  CHECK(U_SUCCESS(status));
+  blink::Thread::MainThread()->Scheduler()->ToMainThreadScheduler()
+      ->ForEachMainThreadIsolate([](v8::Isolate* isolate) {
+        isolate->LocaleConfigurationChangeNotification();
+        isolate->DateTimeConfigurationChangeNotification();
+      });
+}
