+void Session::SetOyaTimeZone(gin_helper::ErrorThrower thrower,
+                           const std::string& zone) {
+  if (zone.empty() || zone.size() > 128 || !base::IsStringASCII(zone) ||
+      zone.find('\0') != std::string::npos) {
+    thrower.ThrowTypeError("Invalid native session timezone");
+    return;
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  UBool system_id = false;
+  icu::UnicodeString canonical;
+  icu::TimeZone::getCanonicalID(icu::UnicodeString::fromUTF8(zone), canonical,
+                              system_id, status);
+  if (U_FAILURE(status) || !system_id) {
+    thrower.ThrowTypeError("Invalid native session timezone");
+    return;
+  }
+  if (!browser_context_->SetOyaTimeZone(zone))
+    thrower.ThrowError("Native timezone must be installed before any session renderer and cannot be changed");
+}
