+    bool cmtg_key_requested,
+    std::optional<std::string_view> user_name,
+    bool is_enclave_authenticator_available,
+    device::FidoDiscoveryFactory* factory) {
+  if (!NativePasskeysEnabled(factory, presentation_, request_source))
+    return;
+  auto* window = NativePasskeyWindow(render_frame_host_id_);
+  if (!window)
+    return;
+  // Apple owns consent, biometric verification, key material and cancellation.
+  // Do not race a second device-local Touch ID dialog against the Apple sheet.
+  factory->set_mac_touch_id_info(std::nullopt);
+  factory->set_nswindow(window->GetNativeWindow());
+}
