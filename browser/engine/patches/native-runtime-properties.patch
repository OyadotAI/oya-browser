+    if (keys->Length() > kProperties - visited) return "Native property limit exceeded";
+    visited += keys->Length();
+    for (uint32_t i = 0; i < keys->Length(); ++i) {
+      v8::Local<v8::Value> key;
+      if (!keys->Get(context, i).ToLocal(&key) || !key->IsName()) return "Cannot read native property key";
+      bool seen = false;
+      for (const auto& slot : *slots) if (slot.key->StrictEquals(key)) { seen = true; break; }
