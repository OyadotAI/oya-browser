+/** Browser-owned frame runtime. No debugger, inspector session, or protocol forwarding. */
+#ifndef ELECTRON_SHELL_RENDERER_OYA_RUNTIME_H_
+#define ELECTRON_SHELL_RENDERER_OYA_RUNTIME_H_
+#include <memory>
+#include "base/memory/weak_ptr.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "mojo/public/cpp/bindings/associated_receiver.h"
+#include "shell/common/api/api.mojom.h"
+namespace electron {
+struct OyaRuntimeState;
+/** One renderer frame owns its document-scoped native value registry. */
+class OyaRuntime : public content::RenderFrameObserver, public mojom::OyaRuntime {
+ public:
+  explicit OyaRuntime(content::RenderFrame* frame);
+  ~OyaRuntime() override;
+  void Perform(const std::string& owner, const std::string& context,
+               const std::string& operation, base::Value parameters,
+               PerformCallback callback) override;
+ private:
+  void Bind(mojo::PendingAssociatedReceiver<mojom::OyaRuntime> receiver);
+  void OnDestruct() override;
+  void WillReleaseScriptContext(v8::Isolate*, v8::Local<v8::Context>, int32_t) override;
+  void Clear();
+  std::shared_ptr<OyaRuntimeState> state_;
+  mojo::AssociatedReceiver<mojom::OyaRuntime> receiver_{this};
+  base::WeakPtrFactory<OyaRuntime> weak_factory_{this};
+};
+}
+#endif
