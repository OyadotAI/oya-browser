+bool FileSelectHelper::MaybeHandleOyaFileChooser(const FileChooserParams& params) {
+  if (params.mode != FileChooserParams::Mode::kOpen &&
+      params.mode != FileChooserParams::Mode::kOpenMultiple)
+    return false;
+  if (!render_frame_host_ || !web_contents_)
+    return false;
+  auto* contents = electron::api::WebContents::From(web_contents_);
+  if (!contents)
+    return false;
+  auto document = render_frame_host_->GetWeakDocumentPtr();
+  // first: browser claimed the request, second: already completed/cancelled.
+  auto state = std::make_shared<std::pair<bool, bool>>(false, false);
+  auto self = scoped_refptr<FileSelectHelper>(this);
+  auto reply = base::BindOnce(
+      [](scoped_refptr<FileSelectHelper> self, content::WeakDocumentPtr document,
+         std::shared_ptr<std::pair<bool, bool>> state, FileChooserParams::Mode mode,
+         std::vector<base::FilePath> paths) {
+        content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(
+          [](scoped_refptr<FileSelectHelper> self, content::WeakDocumentPtr document,
+             std::shared_ptr<std::pair<bool, bool>> state, FileChooserParams::Mode mode,
+             std::vector<base::FilePath> paths) {
+            if (!state->first || state->second) return;
+            state->second = true;
+            if (!document.AsRenderFrameHostIfValid() || !self->render_frame_host_ ||
+                !self->web_contents_ || paths.empty() ||
+                (mode == FileChooserParams::Mode::kOpen && paths.size() != 1)) {
+              self->FileSelectionCanceled();
+              return;
+            }
+            for (const auto& path : paths) {
+              if (!path.IsAbsolute() || path.ReferencesParent()) {
+                self->FileSelectionCanceled();
+                return;
+              }
+            }
+            self->MultiFilesSelected(ui::FilePathListToSelectedFileInfoList(paths));
+          }, self, document, state, mode, std::move(paths)));
+      }, self, document, state, params.mode);
+  auto* isolate = electron::JavascriptEnvironment::GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  auto details = gin::Dictionary::CreateEmpty(isolate);
+  details.Set("url", render_frame_host_->GetLastCommittedURL().spec());
+  details.Set("processId", render_frame_host_->GetProcess()->GetDeprecatedID());
+  details.Set("routingId", render_frame_host_->GetRoutingID());
+  details.Set("multiple", params.mode == FileChooserParams::Mode::kOpenMultiple);
+  state->first = contents->Emit("-oya-file-chooser", details, std::move(reply));
+  if (state->first) {
+    // A disconnected agent must not leave a renderer waiting or retain this request forever.
+    content::GetUIThreadTaskRunner({})->PostDelayedTask(FROM_HERE, base::BindOnce(
+        [](scoped_refptr<FileSelectHelper> self,
+           std::shared_ptr<std::pair<bool, bool>> state) {
+          if (state->second) return;
+          state->second = true;
+          self->FileSelectionCanceled();
+        }, self, state), base::Seconds(30));
+  }
+  return state->first;
+}
