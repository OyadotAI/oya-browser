+namespace {
 
+// Chrome's TLS Trust Anchor IDs, set as chrome/browser/ssl/ssl_config_service_manager.cc
+// sets them in Chromium 152 (GetNewSSLConfig): the list from the compiled-in Chrome Root
+// Store. Electron has no such layer, so its sessions sent a ClientHello without the
+// trust_anchors extension (0xca34) every Chrome since 147 sends: a JA4
+// (t13d1516h2_...) no Chrome has, which anti-bot vendors read before any page runs.
+// Whether the extension is sent stays with net::features::kTLSTrustAnchorIDs.
+void AddChromeTrustAnchorIDs(network::mojom::SSLConfig* config) {
+#if BUILDFLAG(CHROME_ROOT_STORE_SUPPORTED)
+  config->trust_anchor_ids =
+      net::TrustStoreChrome::GetTrustAnchorIDsFromCompiledInRootStore();
+#endif
+}
