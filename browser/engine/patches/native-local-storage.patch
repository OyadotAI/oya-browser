+/** Native session-local storage operations; no renderer scripts or debugging protocol. */
+namespace {
+using OyaStorageEntries = std::vector<std::vector<std::u16string>>;
+constexpr size_t kOyaStorageMaxEntries = 4096;
+constexpr size_t kOyaStorageMaxUnits = 1024 * 1024;
+constexpr auto kOyaStorageTimeout = base::Seconds(15);
+
+/** Match Blink's localStorage encoding, retaining NUL and unpaired UTF-16 code units. */
+std::vector<uint8_t> EncodeOyaStorage(const std::u16string& text) {
+  bool latin = std::ranges::all_of(text, [](char16_t c) { return c <= 255; });
+  std::vector<uint8_t> bytes;
+  bytes.reserve(1 + text.size() * (latin ? 1 : 2));
+  bytes.push_back(latin ? 1 : 0);
+  for (char16_t c : text) {
+    bytes.push_back(c & 255);
+    if (!latin) bytes.push_back(c >> 8);
+  }
+  return bytes;
+}
+
+/** Refuse unknown/corrupt formats rather than returning a fabricated empty value. */
+std::optional<std::u16string> DecodeOyaStorage(const std::vector<uint8_t>& bytes) {
+  if (bytes.empty()) return std::u16string();
+  if (bytes[0] > 1 || (bytes[0] == 0 && bytes.size() % 2 != 1)) return std::nullopt;
+  std::u16string text;
+  for (size_t i = 1; i < bytes.size(); i += bytes[0] ? 1 : 2) {
+    char16_t c = bytes[i];
+    if (!bytes[0]) c |= static_cast<char16_t>(bytes[i + 1]) << 8;
+    text.push_back(c);
+  }
+  return text;
+}
+
+/** Bound imports before any mutation and reject duplicate keys or malformed pairs. */
+bool ValidOyaStorage(const OyaStorageEntries& entries) {
+  if (entries.size() > kOyaStorageMaxEntries) return false;
+  size_t units = 0;
+  std::set<std::u16string> keys;
+  for (const auto& pair : entries) {
+    if (pair.size() != 2 || !keys.insert(pair[0]).second) return false;
+    units += pair[0].size() + pair[1].size();
+    if (units > kOyaStorageMaxUnits) return false;
+  }
+  return true;
+}
