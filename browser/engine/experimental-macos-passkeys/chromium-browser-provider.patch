+  discoveries.push_back(std::make_unique<HybridProbeDiscovery>(
+      FidoTransportProtocol::kHybrid, true, starts));
+  TestObserver observer;
+  HybridProbeHandler handler(&fake_discovery_factory_, std::move(discoveries),
+                             {FidoTransportProtocol::kHybrid});
+  handler.SetObserver(&observer);
+  auto info = observer.WaitForTransportAvailabilityInfo();
+  EXPECT_TRUE(
+      info.available_transports.contains(FidoTransportProtocol::kHybrid));
+  EXPECT_TRUE(info.has_os_managed_hybrid);
+  EXPECT_FALSE(info.ble_status_is_known);
+  EXPECT_EQ(handler.browser_ble_setups, 0u);
+  EXPECT_EQ(*starts, 1u);
