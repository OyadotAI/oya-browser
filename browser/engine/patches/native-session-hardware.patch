+void Session::SetOyaHardwareConcurrency(gin_helper::ErrorThrower thrower,
+                                      double count) {
+  constexpr double kMaxNativeHardwareConcurrency = 256;
+  if (!std::isfinite(count) || count < 1 || count > kMaxNativeHardwareConcurrency ||
+      std::floor(count) != count) {
+    thrower.ThrowTypeError("Invalid native hardware concurrency");
+    return;
+  }
+  if (!browser_context_->SetOyaHardwareConcurrency(static_cast<unsigned>(count)))
+    thrower.ThrowError("Native hardware concurrency must be installed before any session renderer and cannot be changed");
+}
