+// The parent's renderer sees a remote proxy token for cross-process children.
+// Returning that exact identity avoids window.frames indices, which omit shadow
+// frame owners and cannot establish a trustworthy owner relationship.
+std::string WebFrameMain::OyaOwnerFrameToken() const {
+  if (!CheckRenderFrame())
+    return "";
+  auto* child = static_cast<content::RenderFrameHostImpl*>(render_frame_host());
+  auto* parent = child->GetParent();
+  if (!parent)
+    return "";
+  auto* parent_group = parent->GetSiteInstance()->group();
+  if (child->GetSiteInstance()->group() == parent_group)
+    return child->GetFrameToken().ToString();
+  auto* proxy = child->browsing_context_state()->GetRenderFrameProxyHost(parent_group);
+  return proxy ? proxy->GetFrameToken().ToString() : "";
 }
 
