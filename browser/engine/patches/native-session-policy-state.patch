+// Read browser-owned policy state, not page claims or inspector emulation.
+v8::Local<v8::Value> Session::GetOyaSessionPolicy(v8::Isolate* isolate) {
+  constexpr int kOyaPolicyVersion = 1;
+  auto result = gin_helper::Dictionary::CreateEmpty(isolate);
+  result.Set("version", kOyaPolicyVersion);
+  result.Set("rendererStarted", browser_context_->HasOyaRendererStarted());
+  result.Set("timeZone", browser_context_->GetOyaTimeZone());
+  result.Set("locale", browser_context_->GetOyaLocale());
+  result.Set("hardwareConcurrency", browser_context_->GetOyaHardwareConcurrency());
+  result.Set("acceptLanguages", browser_context_->GetOyaAcceptLanguages());
+  return result.GetHandle();
+}
