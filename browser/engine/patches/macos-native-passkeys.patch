+#if BUILDFLAG(IS_MAC)
+// Bind Apple's sheet only to a live foreground native owner.
+NativeWindow* NativePasskeyWindow(content::GlobalRenderFrameHostId id) {
+  auto* frame = content::RenderFrameHost::FromID(id);
+  auto* contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  auto* relay = contents ? NativeWindowRelay::FromWebContents(contents) : nullptr;
+  auto* window = relay ? relay->GetNativeWindow() : nullptr;
+  if (!window || !window->IsFocused() || !window->IsVisible() ||
+      contents->GetVisibility() != content::Visibility::VISIBLE)
+    return nullptr;
+  return window;
+}
+
+// Never replace test devices or open a modal sheet for an autofill request.
+bool NativePasskeysEnabled(
+    device::FidoDiscoveryFactory* factory,
+    content::AuthenticatorRequestClientDelegate::UIPresentation presentation,
+    content::AuthenticatorRequestClientDelegate::RequestSource source) {
+  using Delegate = content::AuthenticatorRequestClientDelegate;
+  return factory && !factory->IsTestOverride() &&
+         presentation == Delegate::UIPresentation::kModal &&
+         source == Delegate::RequestSource::kWebAuthentication &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch("oya-native-passkeys") &&
+         device::fido::icloud_keychain::IsSupported();
+}
+#endif
