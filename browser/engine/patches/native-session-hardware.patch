+// One browser-owned value covers both Navigator and WorkerNavigator natively.
+void ApplyOyaHardwareConcurrency() {
+  auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("oya-session-hardware-concurrency")) return;
+  unsigned count = 0;
+  CHECK(base::StringToUint(command_line->GetSwitchValueASCII(
+      "oya-session-hardware-concurrency"), &count));
+  blink::NavigatorConcurrentHardware::SetOyaHardwareConcurrency(count);
+}
