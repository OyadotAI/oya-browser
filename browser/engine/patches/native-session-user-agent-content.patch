+// Copyright 2026 Oya. All rights reserved.
+// Session-owned native user-agent strings for worker startup, without a debugger.
+#ifndef CONTENT_PUBLIC_BROWSER_OYA_SESSION_USER_AGENT_H_
+#define CONTENT_PUBLIC_BROWSER_OYA_SESSION_USER_AGENT_H_
+#include <string>
+#include "content/common/content_export.h"
+namespace content {
+class BrowserContext;
+// Returns null for an unconfigured context; ownership remains with the context.
+CONTENT_EXPORT const std::string* GetOyaSessionUserAgent(BrowserContext* context);
+// Trusted embedder installs before renderer startup; subsequent changes fail.
+CONTENT_EXPORT bool SetOyaSessionUserAgent(BrowserContext* context,
+                                          const std::string& user_agent);
+// Legacy global behavior remains unchanged for unconfigured contexts.
+CONTENT_EXPORT std::string GetUserAgentForOyaContext(BrowserContext* context);
+}  // namespace content
+#endif  // CONTENT_PUBLIC_BROWSER_OYA_SESSION_USER_AGENT_H_
