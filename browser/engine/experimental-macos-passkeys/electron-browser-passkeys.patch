diff --git a/shell/browser/webauthn/oya_browser_passkey_delegate.cc b/shell/browser/webauthn/oya_browser_passkey_delegate.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4a5720cee9015f4c9bc0c956b26bb51c40d4f014
--- /dev/null
+++ b/shell/browser/webauthn/oya_browser_passkey_delegate.cc
@@ -0,0 +1,227 @@
+/** Keep experimental browser-passkey policy in main, with native request
+ * identity and no credential payload. */
+#include "shell/browser/webauthn/electron_authenticator_request_client_delegate.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/fixed_flat_map.h"
+#include "base/functional/bind.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "device/fido/ctap_get_assertion_request.h"
+#include "gin/arguments.h"
+#include "gin/data_object_builder.h"
+#include "shell/browser/api/electron_api_session.h"
+#include "shell/common/gin_converters/callback_converter.h"
+#include "shell/common/gin_converters/frame_converter.h"
+#include "shell/common/gin_helper/event.h"
+#include "shell/common/gin_helper/event_emitter_caller.h"
+#include "url/origin.h"
+#include "v8/include/cppgc/persistent.h"
+#include "v8/include/v8-exception.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "device/fido/mac/icloud_keychain.h"
+#include "shell/browser/webauthn/electron_authenticator_request_delegate.h"
+#endif
+
+namespace electron {
+namespace {
+
+#if BUILDFLAG(IS_MAC)
+constexpr int kDecisionArgumentCount = 1;
+constexpr auto kTransportNames =
+    base::MakeFixedFlatMap<device::FidoTransportProtocol, std::string_view>({
+        {device::FidoTransportProtocol::kUsbHumanInterfaceDevice, "usb"},
+        {device::FidoTransportProtocol::kNearFieldCommunication, "nfc"},
+        {device::FidoTransportProtocol::kBluetoothLowEnergy, "ble"},
+        {device::FidoTransportProtocol::kInternal, "internal"},
+        {device::FidoTransportProtocol::kHybrid, "hybrid"},
+    });
+
+bool NativeSource(content::RenderFrameHost* frame) {
+  auto* contents =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  return frame && frame->IsActive() && !frame->GetParent() && contents &&
+         frame->GetLastCommittedOrigin().scheme() == "https" &&
+         static_cast<bool>(contents->GetTopLevelNativeWindow());
+}
+
+std::optional<std::vector<std::string>> TransportNames(
+    const base::flat_set<device::FidoTransportProtocol>& transports) {
+  std::vector<std::string> names;
+  for (auto transport : transports) {
+    const auto found = kTransportNames.find(transport);
+    if (found == kTransportNames.end())
+      return std::nullopt;
+    names.emplace_back(found->second);
+  }
+  return names;
+}
+
+void RecordDecision(base::RepeatingCallback<void(bool)> record,
+                    gin::Arguments* args) {
+  v8::Local<v8::Value> value;
+  const bool valid = args->Length() == kDecisionArgumentCount &&
+                     args->GetNext(&value) && value->IsBoolean();
+  record.Run(valid && value.As<v8::Boolean>()->Value());
+}
+
+using WeakSession = cppgc::WeakPersistent<gin::WeakCell<api::Session>>;
+
+void RetireMainLease(const WeakSession& session,
+                     const std::string& attempt_id) {
+  auto* isolate = v8::Isolate::TryGetCurrent();
+  if (!isolate || isolate->GetCurrentContext().IsEmpty() || !session ||
+      !session->Get())
+    return;
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&wrapper))
+    return;
+  auto details = gin::DataObjectBuilder(isolate)
+                     .Set("requestId", attempt_id)
+                     .Set("outcome", "retired")
+                     .Build();
+  auto event = gin_helper::internal::Event::New(isolate)
+                   ->GetWrapper(isolate)
+                   .ToLocalChecked();
+  gin_helper::EmitEvent(isolate, wrapper, "oya-webauthn-ended", event, details);
+}
+
+#endif  // BUILDFLAG(IS_MAC)
+}  // namespace
+
+bool ElectronAuthenticatorRequestClientDelegate::ShouldUseBrowserPasskeyPolicy(
+    const device::CtapGetAssertionRequest& request,
+    const base::flat_set<device::FidoTransportProtocol>& transports,
+    bool is_virtual) const {
+#if BUILDFLAG(IS_MAC)
+  auto* frame = content::RenderFrameHost::FromID(render_frame_host_id_);
+  if (is_virtual ||
+      !ElectronWebAuthenticationDelegate::IsOyaBrowserPasskeysEnabled() ||
+      !NativeSource(frame) ||
+      !transports.contains(device::FidoTransportProtocol::kHybrid))
+    return false;
+  return content::WebContents::FromRenderFrameHost(frame)->GetVisibility() ==
+         content::Visibility::VISIBLE;
+#else
+  return false;
+#endif
+}
+
+bool ElectronAuthenticatorRequestClientDelegate::AuthorizeBrowserPasskeys(
+    const std::string& attempt_id,
+    bool completing,
+    const url::Origin& origin,
+    const std::string& rp_id,
+    const base::flat_set<device::FidoTransportProtocol>& transports,
+    base::RepeatingCallback<void(bool)> decide,
+    base::RepeatingClosure cancel_lifetime) {
+#if BUILDFLAG(IS_MAC)
+  auto* frame = content::RenderFrameHost::FromID(render_frame_host_id_);
+  if (!ElectronWebAuthenticationDelegate::IsOyaBrowserPasskeysEnabled() ||
+      !NativeSource(frame) ||
+      !origin.IsSameOriginWith(frame->GetLastCommittedOrigin()) ||
+      (completing && browser_attempt_id_ != attempt_id))
+    return false;
+  const auto names = TransportNames(transports);
+  auto* session = api::Session::FromBrowserContext(frame->GetBrowserContext());
+  auto* isolate = v8::Isolate::TryGetCurrent();
+  if (!names || !session || !session->Get() || !isolate ||
+      isolate->GetCurrentContext().IsEmpty())
+    return false;
+  browser_attempt_id_ = attempt_id;
+  const std::string original_origin = origin.Serialize();
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> wrapper;
+  if (!session->Get()->GetWrapper(isolate).ToLocal(&wrapper))
+    return false;
+  auto details = gin::DataObjectBuilder(isolate)
+                     .Set("requestId", attempt_id)
+                     .Set("phase", completing ? "complete" : "start")
+                     .Set("frame", frame)
+                     .Set("relyingPartyId", rp_id)
+                     .Set("origin", original_origin)
+                     .Set("kind", "get")
+                     .Set("presentation", "modal")
+                     .Set("transports", *names)
+                     .Build();
+  auto event = gin_helper::internal::Event::New(isolate)
+                   ->GetWrapper(isolate)
+                   .ToLocalChecked();
+  auto weak_this = weak_factory_.GetWeakPtr();
+  v8::TryCatch exception(isolate);
+  // Every call must reach native PolicyState, including a duplicate whose
+  // JavaScript caller catches errors. The ordinary gin callback converter is
+  // one-shot and would hide that duplicate after accepting the first allow.
+  // This GC-owned translator retains only the bounded native attempt callback,
+  // never this delegate, a credential response or a source window.
+  auto decision = gin_helper::CreateFunctionFromTranslator(
+      isolate, base::BindRepeating(&RecordDecision, std::move(decide)),
+      /*one_time=*/false);
+  auto emitted =
+      gin_helper::EmitEvent(isolate, wrapper, "oya-webauthn-request", event,
+                            details, decision, std::move(cancel_lifetime));
+  bool listener = false;
+  if (exception.HasCaught() || isolate->IsExecutionTerminating() ||
+      !weak_this || !gin::ConvertFromV8(isolate, emitted, &listener) ||
+      !listener)
+    return false;
+  auto* current =
+      content::RenderFrameHost::FromID(weak_this->render_frame_host_id_);
+  return weak_this->browser_attempt_id_ == attempt_id &&
+         NativeSource(current) &&
+         current->GetLastCommittedOrigin().Serialize() == original_origin &&
+         ElectronWebAuthenticationDelegate::IsOyaBrowserPasskeysEnabled();
+#else
+  return false;
+#endif
+}
+
+base::OnceClosure ElectronAuthenticatorRequestClientDelegate::
+    CreateBrowserPasskeyRetirementCallback(const std::string& attempt_id) {
+#if BUILDFLAG(IS_MAC)
+  auto* frame = content::RenderFrameHost::FromID(render_frame_host_id_);
+  auto* session =
+      frame ? api::Session::FromBrowserContext(frame->GetBrowserContext())
+            : nullptr;
+  if (!session || !session->Get())
+    return base::OnceClosure();
+  return base::BindOnce(&RetireMainLease, WeakSession(session), attempt_id);
+#else
+  return base::OnceClosure();
+#endif
+}
+
+std::vector<std::unique_ptr<device::FidoDiscoveryBase>>
+ElectronAuthenticatorRequestClientDelegate::CreateBrowserPasskeyDiscoveries(
+    const device::CtapGetAssertionRequest& request,
+    const base::flat_set<device::FidoTransportProtocol>& transports,
+    base::RepeatingCallback<bool()> authorized) {
+  std::vector<std::unique_ptr<device::FidoDiscoveryBase>> discoveries;
+#if BUILDFLAG(IS_MAC)
+  auto* frame = content::RenderFrameHost::FromID(render_frame_host_id_);
+  if (!NativeSource(frame) || !authorized || !authorized.Run() ||
+      !ElectronWebAuthenticationDelegate::IsOyaBrowserPasskeysEnabled() ||
+      !transports.contains(device::FidoTransportProtocol::kHybrid))
+    return discoveries;
+  const auto role =
+      transports.contains(device::FidoTransportProtocol::kInternal)
+          ? device::FidoTransportProtocol::kInternal
+          : device::FidoTransportProtocol::kHybrid;
+  auto discovery = device::fido::icloud_keychain::NewBrowserDiscovery(
+      content::WebContents::FromRenderFrameHost(frame)
+          ->GetTopLevelNativeWindow(),
+      role, request, std::move(authorized));
+  if (discovery)
+    discoveries.push_back(std::move(discovery));
+#endif
+  return discoveries;
+}
+
+}  // namespace electron
