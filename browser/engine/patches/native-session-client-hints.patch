+void ElectronBrowserContext::ClearOyaClientHints() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (auto* hints = static_cast<OyaClientHints*>(GetUserData(&kOyaClientHintsKey)))
+    hints->Clear();
