+// Validate completely before installing immutable browser-owned metadata.
+void Session::SetOyaUserAgentMetadata(gin_helper::ErrorThrower thrower,
+                                     base::DictValue input) {
+  blink::UserAgentMetadata metadata;
+  if (!ReadOyaMetadata(input, &metadata)) {
+    thrower.ThrowTypeError("Invalid native user-agent metadata");
+    return;
+  }
+  if (!content::GetOyaSessionUserAgent(browser_context_)) {
+    thrower.ThrowError("Native user-agent string must be installed before metadata");
+    return;
+  }
+  const auto* installed = content::GetOyaSessionUserAgentMetadata(browser_context_);
+  if ((!installed && browser_context_->HasOyaRendererStarted()) ||
+      (installed && *installed != metadata)) {
+    thrower.ThrowError("Native user-agent metadata must be installed before any session renderer and cannot be changed");
+    return;
+  }
+  CHECK(content::SetOyaSessionUserAgentMetadata(browser_context_, metadata));
 }
 
