+namespace {
+// Nullopt retains Electron's device-local Touch ID availability fallback.
+void ResolvePlatformAvailability(
+    base::OnceCallback<void(std::optional<bool>)> callback,
+    std::optional<bool> testing_override) {
+  if (!testing_override.has_value() &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch("oya-native-passkeys") &&
+      device::fido::icloud_keychain::IsSupported()) {
+    testing_override = true;
+  }
+  std::move(callback).Run(testing_override);
+}
+}  // namespace
