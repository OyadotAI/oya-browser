+  // Search author shadow roots as well as light DOM; ambiguity fails closed.
+  std::string OyaFrameTokenForSelector(v8::Isolate* isolate,
+                                       const std::string& selector) {
+    content::RenderFrame* render_frame;
+    if (!MaybeGetRenderFrame(isolate, "oyaFrameTokenForSelector", &render_frame))
+      return "";
+    std::vector<blink::WebNode> roots{render_frame->GetWebFrame()->GetDocument()};
+    std::string token;
+    size_t matches = 0;
+    for (size_t i = 0; i < roots.size(); ++i) {
+      for (const auto& element : roots[i].QuerySelectorAll(blink::WebString::FromUtf8(selector))) {
+        ++matches;
+        auto* frame = blink::WebFrame::FromFrameOwnerElement(element);
+        if (frame)
+          token = frame->GetFrameToken().ToString();
+      }
+      for (const auto& element : roots[i].QuerySelectorAll(blink::WebString::FromUtf8("*"))) {
+        auto shadow = element.ShadowRoot();
+        if (!shadow.IsNull())
+          roots.push_back(shadow);
+      }
+    }
+    return matches == 1 ? token : "";
+  }
