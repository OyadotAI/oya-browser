+// Deliver text to the focused widget, including an out-of-process child frame.
+// The renderer webFrame helper can have no active input controller in the main
+// process when focus belongs to another renderer and must not be dereferenced.
+v8::Local<v8::Promise> WebContents::InsertText(
+    v8::Isolate* isolate, const std::u16string& text) {
+  gin_helper::Promise<void> promise(isolate);
+  auto handle = promise.GetHandle();
+  auto* frame = web_contents()->GetFocusedFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    promise.RejectWithErrorMessage("No live focused frame for text insertion");
+    return handle;
+  }
+  auto* widget = static_cast<content::RenderWidgetHostImpl*>(
+      frame->GetRenderWidgetHost());
+  if (!widget) {
+    promise.RejectWithErrorMessage("No focused widget for text insertion");
+    return handle;
+  }
+  widget->ImeCommitText(text, {}, gfx::Range::InvalidRange(), 0);
+  promise.Resolve();
+  return handle;
+}
