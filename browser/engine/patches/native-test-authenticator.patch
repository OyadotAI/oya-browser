+// The simulator is a main-process test seam, never a renderer or agent capability.
+void WebContents::SetOyaTestAuthenticator(v8::Isolate* isolate, bool enabled) {
+  auto fail = [isolate](const char* message) {
+    isolate->ThrowException(v8::Exception::Error(gin::StringToV8(isolate, message)));
+  };
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "oya-test-virtual-authenticator")) {
+    fail("Native test authenticator requires explicit test opt-in");
+    return;
+  }
+  if (!web_contents()->GetBrowserContext()->IsOffTheRecord()) {
+    fail("Native test authenticator requires an ephemeral session");
+    return;
+  }
+  auto* frame = static_cast<content::RenderFrameHostImpl*>(
+      web_contents()->GetPrimaryMainFrame());
+  if (!frame || !frame->IsActive()) {
+    fail("Native test authenticator requires an active owning document");
+    return;
+  }
+  auto* environment = content::AuthenticatorEnvironment::GetInstance();
+  auto* node = frame->frame_tree_node();
+  if (!enabled) {
+    if (!owns_oya_test_authenticator_) {
+      fail("This WebContents does not own a native test authenticator");
+      return;
+    }
+    environment->DisableVirtualAuthenticatorFor(node);
+    owns_oya_test_authenticator_ = false;
+    return;
+  }
+  if (environment->IsVirtualAuthenticatorEnabledFor(node)) {
+    fail("An authenticator environment is already enabled for this document");
+    return;
+  }
+  environment->EnableVirtualAuthenticatorFor(node, false);
+  auto* manager = environment->MaybeGetVirtualAuthenticatorManager(node);
+  content::VirtualAuthenticator::Options options;
+  options.protocol = device::ProtocolVersion::kCtap2;
+  options.transport = device::FidoTransportProtocol::kInternal;
+  options.attachment = device::AuthenticatorAttachment::kPlatform;
+  options.has_resident_key = true;
+  options.has_user_verification = true;
+  if (!manager || !manager->AddAuthenticatorAndReturnNonOwningPointer(options)) {
+    environment->DisableVirtualAuthenticatorFor(node);
+    fail("Native test authenticator could not be created");
+    return;
+  }
+  owns_oya_test_authenticator_ = true;
+}
+
+void WebContents::SetOyaTestAuthenticatorPresence(v8::Isolate* isolate,
+                                                 bool present) {
+  auto fail = [isolate]() {
+    isolate->ThrowException(v8::Exception::Error(gin::StringToV8(
+        isolate, "This WebContents does not own an opted-in native test authenticator")));
+  };
+  if (!owns_oya_test_authenticator_ ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "oya-test-virtual-authenticator") ||
+      !web_contents()->GetBrowserContext()->IsOffTheRecord()) {
+    fail();
+    return;
+  }
+  auto* frame = static_cast<content::RenderFrameHostImpl*>(
+      web_contents()->GetPrimaryMainFrame());
+  auto* manager = frame && frame->IsActive()
+      ? content::AuthenticatorEnvironment::GetInstance()
+            ->MaybeGetVirtualAuthenticatorManager(frame->frame_tree_node())
+      : nullptr;
+  if (!manager || manager->GetAuthenticators().size() != 1) {
+    fail();
+    return;
+  }
+  manager->GetAuthenticators().front()->SetUserPresence(present);
+}
