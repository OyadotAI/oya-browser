+// Install a bounded, immutable HTTP field before the first session renderer.
+void Session::SetOyaUserAgent(gin_helper::ErrorThrower thrower,
+                              const std::string& user_agent) {
+  constexpr size_t kMaxNativeUserAgentLength = 1024;
+  if (user_agent.empty() || user_agent.size() > kMaxNativeUserAgentLength ||
+      !std::all_of(user_agent.begin(), user_agent.end(),
+                   [](unsigned char c) { return c >= 32 && c <= 126; })) {
+    thrower.ThrowTypeError("Invalid native user agent");
+    return;
+  }
+  const auto* installed = content::GetOyaSessionUserAgent(browser_context_);
+  if ((!installed && browser_context_->HasOyaRendererStarted()) ||
+      (installed && *installed != user_agent)) {
+    thrower.ThrowError("Native user agent must be installed before any session renderer and cannot be changed");
+    return;
+  }
+  CHECK(content::SetOyaSessionUserAgent(browser_context_, user_agent));
+  browser_context_->SetUserAgent(user_agent);
+  browser_context_->ForEachLoadedStoragePartition(
+      [&user_agent](content::StoragePartition* partition) {
+        partition->GetNetworkContext()->SetUserAgent(user_agent);
+      });
+}
