+void Session::SetOyaLocale(gin_helper::ErrorThrower thrower,
+                           const std::string& locale) {
+  constexpr size_t kMaxNativeLocaleLength = 128;
+  if (locale.empty() || locale.size() > kMaxNativeLocaleLength ||
+      !base::IsStringASCII(locale) || locale.find('\0') != std::string::npos) {
+    thrower.ThrowTypeError("Invalid native locale tag");
+    return;
+  }
+  char id[ULOC_FULLNAME_CAPACITY];
+  int32_t parsed = 0;
+  UErrorCode status = U_ZERO_ERROR;
+  const int32_t length =
+      uloc_forLanguageTag(locale.c_str(), id, sizeof(id), &parsed, &status);
+  if (U_FAILURE(status) || length <= 0 ||
+      length >= static_cast<int32_t>(sizeof(id)) ||
+      parsed != static_cast<int32_t>(locale.size())) {
+    thrower.ThrowTypeError("Invalid native locale tag");
+    return;
+  }
+  const auto value = icu::Locale::createCanonical(id);
+  const auto canonical = value.toLanguageTag<std::string>(status);
+  if (U_FAILURE(status) || value.isBogus() || !*value.getLanguage()) {
+    thrower.ThrowTypeError("Native locale must specify a language");
+    return;
+  }
+  if (!browser_context_->SetOyaLocale(canonical))
+    thrower.ThrowError("Native locale must be installed before any session renderer and cannot be changed");
+}
