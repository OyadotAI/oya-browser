 using blink::WebMouseWheelEvent;
 
 namespace content {
+
+namespace {
+const int kOyaDragHandlerKey = 0;
+class OyaDragHandlerData : public base::SupportsUserData::Data {
+ public:
+  explicit OyaDragHandlerData(OyaDragHandler callback) : handler(std::move(callback)) {}
+  OyaDragHandler handler;
+};
+}  // namespace
+
+bool SetOyaDragHandler(WebContents* contents, OyaDragHandler handler) {
+  if (contents->GetUserData(&kOyaDragHandlerKey)) return false;
+  contents->SetUserData(&kOyaDragHandlerKey,
+      std::make_unique<OyaDragHandlerData>(std::move(handler)));
+  return true;
+}
+void ClearOyaDragHandler(WebContents* contents) {
+  contents->RemoveUserData(&kOyaDragHandlerKey);
+}
