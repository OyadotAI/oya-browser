+  // The same exact-document lease bounds native runtime replies, not just isolated execution.
+  void Runtime(electron::mojom::OyaRuntime* runtime, const std::string& owner,
+               const std::string& context, const std::string& operation, base::Value parameters) {
+    auto* frame = document_.AsRenderFrameHostIfValid();
