+// Validate both sources before freezing the BrowserContext. No source executes
+// in the browser process, and syntax failures cannot partially install a policy.
+void Session::SetOyaPreScriptPolicy(gin_helper::ErrorThrower thrower,
+                                    base::DictValue input) {
+  constexpr size_t kMaxOyaScriptBytes = 1024 * 1024;
+  const auto* page = input.FindString("page");
+  const auto* worker = input.FindString("worker");
+  if (input.size() != 2 || !page || !worker || page->empty() ||
+      page->size() > kMaxOyaScriptBytes || worker->size() > kMaxOyaScriptBytes) {
+    thrower.ThrowTypeError("Native pre-script policy requires bounded page and worker sources");
+    return;
+  }
+  auto* isolate = v8::Isolate::GetCurrent();
+  const auto valid = [isolate](const std::string& text) {
+    v8::TryCatch caught(isolate);
+    v8::Local<v8::String> source;
+    if (!v8::String::NewFromUtf8(isolate, text.data(), v8::NewStringType::kNormal,
+                               static_cast<int>(text.size())).ToLocal(&source))
+      return false;
+    v8::ScriptCompiler::Source script(source);
+    v8::Local<v8::UnboundScript> compiled;
+    return v8::ScriptCompiler::CompileUnboundScript(isolate, &script).ToLocal(&compiled);
+  };
+  if (!valid(*page) || !valid(*worker)) {
+    thrower.ThrowTypeError("Invalid native pre-script syntax");
+    return;
+  }
+  if (!browser_context_->SetOyaPreScripts(*page, *worker))
+    thrower.ThrowError("Native pre-script policy must precede all session renderers and cannot change");
 }
 
