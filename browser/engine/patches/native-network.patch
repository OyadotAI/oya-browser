+/** A separate native callback cannot overwrite the session's ordinary request observers. */
+void WebRequest::SetOyaBodyListener(gin::Arguments* args) {
+  ++oya_body_epoch_;
+  v8::Local<v8::Value> value;
+  if (!args->GetNext(&value)) return args->ThrowTypeError("Native body listener required");
+  if (value->IsNull()) { oya_body_listener_.Reset(); return; }
+  SimpleListener listener;
+  if (!gin::ConvertFromV8(args->isolate(), value, &listener)) return args->ThrowTypeError("Native body listener must be a function or null");
+  oya_body_listener_ = std::move(listener);
+}
+/** Per-request callbacks carry no page state and cannot deliver into a later listener epoch. */
+mojo::ScopedDataPipeConsumerHandle WebRequest::CaptureBody(extensions::WebRequestInfo* info, mojo::ScopedDataPipeConsumerHandle body) {
+  if (!oya_body_listener_) return body;
+  auto* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope handles(isolate);
+  auto& allocation = isolate->GetCppHeap()->GetAllocationHandle();
+  return electron::CaptureOyaBody(std::move(body), oya_body_quota_, base::BindPostTaskToCurrentDefault(base::BindOnce(
+      &WebRequest::OyaBodyReady, gin::WrapPersistent(weak_factory_.GetWeakCell(allocation)), oya_body_epoch_, info->id)));
+}
+/** Body bytes are opaque base64; the external adapter owns target authorization and bounded retention. */
+void WebRequest::OyaBodyReady(uint64_t epoch, uint64_t request, std::string body, std::string error) {
+  if (!oya_body_listener_ || epoch != oya_body_epoch_) return;
+  auto* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope handles(isolate);
+  gin_helper::Dictionary details(isolate, v8::Object::New(isolate));
+  details.Set("id", request);
+  details.Set("body", base::Base64Encode(body));
+  details.Set("error", error);
+  oya_body_listener_.Run(gin::ConvertToV8(isolate, details));
+}
+
 const gin::WrapperInfo* WebRequest::wrapper_info() const {
   return &kWrapperInfo;
 }
