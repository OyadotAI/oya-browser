 namespace {
 
+// Acknowledged native composition holds one document and never moves OS focus.
+class OyaTextInsertion : public content::WebContentsObserver,
+                         public base::RefCounted<OyaTextInsertion> {
+ public:
+  OyaTextInsertion(content::RenderFrameHost* frame, gin_helper::Promise<void> promise)
+      : content::WebContentsObserver(content::WebContents::FromRenderFrameHost(frame)),
+        document_(frame->GetWeakDocumentPtr()), frame_id_(frame->GetGlobalId()),
+        promise_(std::move(promise)) {}
+
+  void Execute(const std::u16string& text) {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    if (!frame || !frame->IsActive()) { Cancel("Text input document is unavailable"); return; }
+    if (!Pending().insert(frame_id_).second) { Cancel("Native text insertion already pending"); return; }
+    owns_slot_ = true;
+    auto* widget = static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost());
+    was_focused_ = widget->is_focused();
+    deadline_.Start(FROM_HERE, base::Seconds(10), base::BindOnce(
+        &OyaTextInsertion::Cancel, base::WrapRefCounted(this), "Native text insertion timed out"));
+    // Blink needs widget focus for IME; this does not focus a native window,
+    // dismiss Oya's control shield, or forward human keyboard input.
+    widget->Focus();
+    widget->GetWidgetInputHandler()->ImeCommitText(
+        text, {}, gfx::Range::InvalidRange(), 0, blink::DOMNodeIdType(),
+        mojo::WrapCallbackWithDropHandler(
+            base::BindOnce(&OyaTextInsertion::Complete, weak_factory_.GetWeakPtr()),
+            base::BindOnce(&OyaTextInsertion::Cancel, weak_factory_.GetWeakPtr(),
+                           "Native text input channel closed")));
+  }
+
+ private:
+  friend class base::RefCounted<OyaTextInsertion>;
+  ~OyaTextInsertion() override = default;
+  static std::set<content::GlobalRenderFrameHostId>& Pending() {
+    static base::NoDestructor<std::set<content::GlobalRenderFrameHostId>> pending;
+    return *pending;
+  }
+  bool Settle() {
+    if (settled_) return false;
+    settled_ = true;
+    deadline_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+    RestoreFocus();
+    if (owns_slot_) Pending().erase(frame_id_);
+    Observe(nullptr);
+    return true;
+  }
+  // Never blur a real native focus gained while the renderer was acknowledging.
+  void RestoreFocus() {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    if (!owns_slot_ || was_focused_ || !frame || !frame->IsActive()) return;
+    auto* widget = static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost());
+    auto* view = widget->GetView();
+    if (view && !view->HasFocus()) widget->Blur();
+  }
+  void Complete() {
+    scoped_refptr<OyaTextInsertion> keep_alive(this);
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    if (!frame || !frame->IsActive()) { Cancel("Text input document was replaced"); return; }
+    if (Settle()) promise_.Resolve();
+  }
+  void Cancel(std::string_view error) {
+    scoped_refptr<OyaTextInsertion> keep_alive(this);
+    if (Settle()) promise_.RejectWithErrorMessage(error);
+  }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (frame->GetGlobalId() == frame_id_) Cancel("Text input frame was deleted");
+  }
+  void RenderFrameHostChanged(content::RenderFrameHost* old_frame,
+                             content::RenderFrameHost*) override {
+    if (old_frame && old_frame->GetGlobalId() == frame_id_) Cancel("Text input frame was replaced");
+  }
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->HasCommitted() && !navigation->IsSameDocument() &&
+        !document_.AsRenderFrameHostIfValid()) Cancel("Text input document was replaced");
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    Cancel("Text input renderer exited");
+  }
+  void WebContentsDestroyed() override { Cancel("Text input tab was closed"); }
+  content::WeakDocumentPtr document_;
+  content::GlobalRenderFrameHostId frame_id_;
+  gin_helper::Promise<void> promise_;
+  base::OneShotTimer deadline_;
+  bool owns_slot_ = false;
+  bool was_focused_ = false;
+  bool settled_ = false;
+  base::WeakPtrFactory<OyaTextInsertion> weak_factory_{this};
+};
+
