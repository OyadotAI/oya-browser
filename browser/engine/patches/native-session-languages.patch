+// Shared/service workers can start without an owning WebContents.
+void ElectronBrowserClient::UpdateRendererPreferencesForWorker(
+    content::BrowserContext* browser_context,
+    blink::RendererPreferences* out_prefs) {
+  if (!browser_context) return;
+  const auto languages = static_cast<ElectronBrowserContext*>(
+      browser_context)->GetOyaAcceptLanguages();
+  if (!languages.empty()) out_prefs->accept_languages = languages;
+}
