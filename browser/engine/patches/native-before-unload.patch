+// Only the browser-owned dialog registration enables asynchronous unload decisions.
+void WebContents::SetOyaBeforeUnloadEnabled(bool enabled) {
+  oya_before_unload_enabled_ = enabled;
+}
+
+// Preserve loadURL rejection without attributing an old decision to a new load.
+void WebContents::FinishOyaBeforeUnload(std::optional<GURL> pending_url,
+                                      DialogClosedCallback callback,
+                                      bool accepted,
+                                      const std::u16string& text) {
+  if (pending_url && pending_unload_url_ == pending_url) {
+    pending_unload_url_.reset();
+    if (!accepted) {
+      auto weak_this = GetWeakPtr();
+      Emit("did-fail-load", static_cast<int>(net::ERR_ABORTED),
+           net::ErrorToShortString(net::ERR_ABORTED),
+           pending_url->possibly_invalid_spec(), true);
+      if (!weak_this)
+        return;
+    }
+  }
+  ResyncFocusAfterDialog(std::move(callback)).Run(accepted, std::u16string());
 }
 
