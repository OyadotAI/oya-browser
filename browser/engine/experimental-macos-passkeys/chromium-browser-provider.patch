+TEST(OyaBrowserController, CancelKeepsOwnerUntilActualTerminalCallback) {
+  if (@available(macOS 13.5, *)) {
+    BrowserControllerHarness harness;
+    auto cancel = harness.Start();
+    ASSERT_FALSE(cancel.is_null());
+    ASSERT_EQ(harness.state->controllers.count, 1u);
+    harness.system->Cancel();
+    EXPECT_EQ(harness.state->cancellations, 0u);
+    std::move(cancel).Run();
+    EXPECT_EQ(harness.state->cancellations, 1u);
+    auto rejected = harness.Start();
+    EXPECT_TRUE(rejected.is_null());
+    EXPECT_EQ(harness.state->controllers.count, 1u);
+    FinishBrowserController(harness.state->controllers[0]);
+    ASSERT_EQ(harness.state->results.size(), 2u);
+    EXPECT_EQ(harness.state->results.back(), ASAuthorizationErrorCanceled);
+    auto next = harness.Start();
+    EXPECT_FALSE(next.is_null());
+    EXPECT_EQ(harness.state->controllers.count, 2u);
+  }
+}
+
+TEST(OyaBrowserController,
+     OldCancellationAndDuplicateTerminalCannotAffectNewOwner) {
+  if (@available(macOS 13.5, *)) {
+    BrowserControllerHarness harness;
+    auto old_cancel = harness.Start();
+    auto old_controller = harness.state->controllers[0];
+    auto old_delegate = old_controller.delegate;
+    FinishBrowserController(old_controller);
+    auto current_cancel = harness.Start();
+    std::move(old_cancel).Run();
+    EXPECT_EQ(harness.state->cancellations, 0u);
+    [old_delegate
+        authorizationController:old_controller
+           didCompleteWithError:[NSError
+                                    errorWithDomain:ASAuthorizationErrorDomain
+                                               code:ASAuthorizationErrorFailed
+                                           userInfo:nil]];
+    EXPECT_EQ(harness.state->results.size(), 1u);
+    EXPECT_TRUE(harness.Start().is_null());
+    std::move(current_cancel).Run();
+    EXPECT_EQ(harness.state->cancellations, 1u);
+  }
+}
+
+TEST(OyaBrowserController,
+     SynchronousTerminalBeforeReturningCancelCannotBorrowNextOwner) {
+  if (@available(macOS 13.5, *)) {
+    BrowserControllerHarness harness;
+    harness.state->synchronous_terminal = true;
+    auto completed_cancel = harness.Start();
+    ASSERT_EQ(harness.state->results.size(), 1u);
+    auto current_cancel = harness.Start();
+    std::move(completed_cancel).Run();
+    EXPECT_EQ(harness.state->cancellations, 0u);
+    EXPECT_TRUE(harness.Start().is_null());
+    std::move(current_cancel).Run();
+    EXPECT_EQ(harness.state->cancellations, 1u);
+  }
+}
+
+TEST(OyaBrowserController, MissingTestActionCannotFallBackToOSUI) {
+  if (@available(macOS 13.5, *)) {
+    BrowserAssertionTestHooks hooks;
+    EXPECT_FALSE(NewNativeSystemInterfaceForTesting(hooks));
+    hooks.perform = base::BindRepeating([](ASAuthorizationController*) {});
+    EXPECT_FALSE(NewNativeSystemInterfaceForTesting(std::move(hooks)));
+  }
+}
+
+TEST(OyaBrowserController, NonHybridRequestNeverConstructsController) {
+  if (@available(macOS 13.5, *)) {
+    BrowserControllerHarness harness;
+    CtapGetAssertionRequest request("rp.id", "{}");
+    request.allow_list.emplace_back(CredentialType::kPublicKey,
+                                    std::vector<uint8_t>{1});
+    request.allow_list.back().transports.insert(
+        FidoTransportProtocol::kUsbHumanInterfaceDevice);
+    EXPECT_TRUE(harness.Start(std::move(request)).is_null());
+    EXPECT_EQ(harness.state->controllers.count, 0u);
+    EXPECT_EQ(harness.state->results.size(), 1u);
+  }
+}
+
+TEST(OyaBrowserController, CallerMayDisappearBeforeNativeTerminalCleanup) {
+  if (@available(macOS 13.5, *)) {
+    BrowserControllerHarness harness;
+    auto cancel = harness.Start();
+    harness.system.reset();
+    std::move(cancel).Run();
+    EXPECT_EQ(harness.state->cancellations, 1u);
+    FinishBrowserController(harness.state->controllers[0]);
+    ASSERT_EQ(harness.state->results.size(), 1u);
+    EXPECT_EQ(harness.state->results[0], ASAuthorizationErrorCanceled);
+  }
+}
+
+TEST(OyaBrowserController,
+     RevokedAfterPreparationNeverPerformsAndReleasesOwner) {
+  if (@available(macOS 13.5, *)) {
+    BrowserControllerHarness harness;
+    size_t checks = 0;
+    auto canceled = harness.Start(
+        CtapGetAssertionRequest("rp.id", "{}"),
+        base::BindRepeating([](size_t* checks) { return ++*checks == 1; },
+                            &checks));
+    EXPECT_TRUE(canceled.is_null());
+    EXPECT_EQ(checks, 2u);
+    EXPECT_EQ(harness.state->controllers.count, 0u);
+    EXPECT_EQ(harness.state->results.size(), 1u);
+    EXPECT_FALSE(harness.Start().is_null());
+    EXPECT_EQ(harness.state->controllers.count, 1u);
+  }
+}
+
+TEST_F(iCloudKeychainTest,
+       BrowserDiscoveryReportsOnlyActualHybridRoleAsOsManaged) {
+  if (@available(macOS 13.5, *)) {
+    CtapGetAssertionRequest request("rp.id", "{}");
+    for (auto role :
+         {FidoTransportProtocol::kInternal, FidoTransportProtocol::kHybrid}) {
+      auto discovery =
+          NewBrowserDiscovery(base::apple::WeakNSWindow(), role, request,
+                              base::BindRepeating([] { return true; }));
+      ASSERT_TRUE(discovery);
+      EXPECT_EQ(discovery->transport(), role);
+      EXPECT_EQ(discovery->IsOsManagedHybrid(),
+                role == FidoTransportProtocol::kHybrid);
+    }
+  }
+}
+
 }  // namespace
 
 }  // namespace device::fido::icloud_keychain
diff --git a/device/fido/mac/oya_browser_controller_lease.h b/device/fido/mac/oya_browser_controller_lease.h
new file mode 100644
index 0000000000000000000000000000000000000000..be3df86fe0b66c2cfa98e11449bb61ba2d3a4787
--- /dev/null
+++ b/device/fido/mac/oya_browser_controller_lease.h
@@ -0,0 +1,75 @@
+/** Keep one native authentication controller quarantined until its exact
+ * terminal callback. */
+#ifndef OYA_BROWSER_CONTROLLER_LEASE_H_
+#define OYA_BROWSER_CONTROLLER_LEASE_H_
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace oya::webauthn {
+
+/** Cancellation revokes results immediately but never pretends the OS
+ * controller has ended. */
+class ControllerLease {
+ public:
+  /** A test can seed exhaustion; production starts at zero and never reuses a
+   * token. */
+  explicit ControllerLease(std::uint64_t initial_sequence = 0)
+      : sequence_(initial_sequence) {}
+  ControllerLease(const ControllerLease&) = delete;
+  ControllerLease& operator=(const ControllerLease&) = delete;
+
+  /** Busy or exhausted owners refuse another controller without replacing
+   * current storage. */
+  std::optional<std::uint64_t> Acquire() {
+    if (active_ || sequence_ == std::numeric_limits<std::uint64_t>::max())
+      return std::nullopt;
+    active_ = ++sequence_;
+    revoked_ = false;
+    return active_;
+  }
+
+  /** Only the original operation may send cancellation, and only once. */
+  bool Revoke(std::uint64_t token) {
+    if (!IsCurrent(token) || revoked_)
+      return false;
+    revoked_ = true;
+    return true;
+  }
+
+  /** An old controller's late terminal callback cannot clear a new controller's
+   * slot. */
+  bool Complete(std::uint64_t token) {
+    if (!IsCurrent(token))
+      return false;
+    active_.reset();
+    revoked_ = false;
+    return true;
+  }
+
+  /** Identity remains current during cancellation quarantine. */
+  bool IsCurrent(std::uint64_t token) const {
+    return active_ && *active_ == token;
+  }
+
+  /** A success racing cancellation is unusable even before terminal cleanup
+   * runs. */
+  bool AllowsResult(std::uint64_t token) const {
+    return IsCurrent(token) && !revoked_;
+  }
+
+  /** Lack of an OS terminal acknowledgment keeps capacity at exactly one. */
+  bool busy() const { return active_.has_value(); }
+
+ private:
+  /** Tokens never wrap or transfer across operations. */
+  std::uint64_t sequence_;
+  /** The only operation whose native controller storage may be touched. */
+  std::optional<std::uint64_t> active_;
+  /** Main/request timeout does not release OS ownership. */
+  bool revoked_ = false;
+};
+
+}  // namespace oya::webauthn
+#endif  // OYA_BROWSER_CONTROLLER_LEASE_H_
diff --git a/device/fido/mac/oya_browser_transport_policy.h b/device/fido/mac/oya_browser_transport_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..cc4dfc75ac81c36b2c1cf9a2336059cf11d0d92a
--- /dev/null
+++ b/device/fido/mac/oya_browser_transport_policy.h
@@ -0,0 +1,104 @@
+/** Preserve original per-credential transport restrictions across the Apple
+ * browser authentication flow. */
+#ifndef OYA_BROWSER_TRANSPORT_POLICY_H_
+#define OYA_BROWSER_TRANSPORT_POLICY_H_
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace oya::webauthn {
+
+/** Only verified Apple platform or nearby-phone attachments can produce a
+ * result. */
+enum class BrowserTransport { kInternal, kHybrid };
+
+/** Native-only original descriptor; no credential identifier is sent to
+ * JavaScript policy events. */
+struct BrowserCredentialRule {
+  /** Exact credential bytes supplied by the relying party. */
+  std::vector<std::uint8_t> credential_id;
+  /** Unspecified descriptor transports permit both of these native methods. */
+  bool internal_allowed = false;
+  /** A different credential's hybrid permission cannot authorize this ID. */
+  bool hybrid_allowed = false;
+};
+
+/** An immutable native snapshot combines RP-intersected global transport policy
+ * and individual ID rules. */
+class BrowserTransportPolicy {
+ public:
+  /** The caller derives global permissions from the original validated
+   * transport intersection. */
+  BrowserTransportPolicy(bool internal_allowed,
+                         bool hybrid_allowed,
+                         std::vector<BrowserCredentialRule> rules)
+      : internal_allowed_(internal_allowed),
+        hybrid_allowed_(hybrid_allowed),
+        rules_(std::move(rules)) {}
+
+  /** Hybrid-only requests use a genuine hybrid discovery rather than injecting
+   * internal transport. */
+  std::optional<BrowserTransport> DiscoveryTransport() const {
+    if (!hybrid_allowed_ || !HasHybridCredential())
+      return std::nullopt;
+    return internal_allowed_ ? BrowserTransport::kInternal
+                             : BrowserTransport::kHybrid;
+  }
+
+  /** Unsupported IDs are omitted from the OS request without widening any
+   * original descriptor. */
+  bool IncludeCredential(std::size_t index) const {
+    return index < rules_.size() &&
+           ((internal_allowed_ && rules_[index].internal_allowed) ||
+            (hybrid_allowed_ && rules_[index].hybrid_allowed));
+  }
+
+  /** An actual returned ID and attachment must satisfy the same original
+   * credential's restrictions. */
+  bool AllowsResult(std::span<const std::uint8_t> credential_id,
+                    BrowserTransport actual) const {
+    if (credential_id.empty() || !GlobalAllows(actual))
+      return false;
+    if (rules_.empty())
+      return true;
+    return std::ranges::any_of(rules_, [&](const auto& rule) {
+      return std::ranges::equal(rule.credential_id, credential_id) &&
+             ((actual == BrowserTransport::kInternal &&
+               rule.internal_allowed) ||
+              (actual == BrowserTransport::kHybrid && rule.hybrid_allowed));
+    });
+  }
+
+ private:
+  /** An empty allow-list permits discovery; a nonempty one needs its own
+   * hybrid-eligible entry. */
+  bool HasHybridCredential() const {
+    return rules_.empty() || std::ranges::any_of(rules_, [](const auto& rule) {
+             return rule.hybrid_allowed;
+           });
+  }
+
+  /** Unknown native attachments fail closed rather than being treated as a
+   * phone. */
+  bool GlobalAllows(BrowserTransport actual) const {
+    return (actual == BrowserTransport::kInternal && internal_allowed_) ||
+           (actual == BrowserTransport::kHybrid && hybrid_allowed_);
+  }
+
+  /** Actual RP-intersected internal permission, not inferred from another
+   * allowed ID. */
+  const bool internal_allowed_;
+  /** Actual RP-intersected hybrid permission. */
+  const bool hybrid_allowed_;
+  /** Immutable descriptor snapshot belongs only to this native assertion
+   * attempt. */
+  const std::vector<BrowserCredentialRule> rules_;
+};
+
+}  // namespace oya::webauthn
+#endif  // OYA_BROWSER_TRANSPORT_POLICY_H_
