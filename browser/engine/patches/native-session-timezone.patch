+// Hold the native override for the renderer lifetime. No page-world shim or
+// inspector session is involved; Blink propagates the zone to worker isolates.
+void ApplyOyaSessionTimeZone() {
+  const auto zone = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "oya-session-timezone");
+  if (zone.empty()) return;
+  auto result = blink::TimeZoneController::SetTimeZoneOverride(
+      blink::String::FromUtf8(zone));
+  CHECK(result.status == blink::TimeZoneController::TimeZoneOverrideStatus::kSuccess);
+  CHECK(result.handle);
+  static base::NoDestructor<std::unique_ptr<blink::TimeZoneController::TimeZoneOverride>>
+      owner(std::move(result.handle));
+}
