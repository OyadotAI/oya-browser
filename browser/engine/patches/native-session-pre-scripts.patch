+// This is an embedder initialization operation, not eval supplied by a page.
+// Sources are immutable before worker threads start; no page-world registry,
+// debugging endpoint or inspector is involved. Runtime failure kills this
+// renderer before author code can observe a partially protected context.
+void RunOyaPreScript(v8::Local<v8::Context> context, bool worker) {
+  const auto& policy = OyaScripts();
+  const auto& text = worker ? policy.worker : policy.page;
+  if (text.empty()) return;
+  auto* isolate = v8::Isolate::GetCurrent();
+  v8::HandleScope handles(isolate);
+  v8::Context::Scope scope(context);
+  v8::MicrotasksScope microtasks(isolate, context->GetMicrotaskQueue(),
+                               v8::MicrotasksScope::kDoNotRunMicrotasks);
+  v8::Local<v8::String> source;
+  CHECK(v8::String::NewFromUtf8(isolate, text.data(), v8::NewStringType::kNormal,
+                               static_cast<int>(text.size())).ToLocal(&source));
+  v8::Local<v8::Script> script;
+  CHECK(v8::Script::Compile(context, source).ToLocal(&script));
+  CHECK(!script->Run(context).IsEmpty());
+}
