+namespace electron {
+namespace {
+constexpr size_t kOwners = 64;
+constexpr size_t kHandles = 2048;
+constexpr uint32_t kProperties = 512;
+constexpr size_t kTextBytes = 1048576;
+constexpr size_t kArguments = 128;
+/** Values belong to a single external connection and carry their release group. */
+struct StoredValue {
+  v8::Global<v8::Value> value;
+  std::string group;
+};
+/** Shared ownership lets asynchronous page promises outlive the IPC service safely. */
+struct Owner {
+  bool closed = false;
+  std::map<std::string, StoredValue> handles;
+};
+/** Errors are distinct from page-thrown values, never silently converted to undefined. */
+base::Value Failure(const std::string& message) {
+  return base::Value(base::DictValue().Set("error", message));
+}
+std::string String(v8::Isolate* isolate, v8::Local<v8::Value> value) {
+  v8::String::Utf8Value text(isolate, value);
+  if (!*text || text.length() > static_cast<int>(kTextBytes)) return {};
+  return std::string(*text, text.length());
+}
+v8::Local<v8::String> Key(v8::Isolate* isolate, const std::string& text) {
+  return v8::String::NewFromUtf8(isolate, text.data(), v8::NewStringType::kNormal, text.size()).ToLocalChecked();
+}
+std::string Param(const base::DictValue& p, const char* key) {
+  const auto* value = p.FindString(key);
+  return value ? *value : std::string();
+}
+/** Built-in type checks do not inspect page properties or invoke getters. */
+std::string Subtype(v8::Local<v8::Value> value) {
+  if (value->IsArray()) return "array";
+  if (value->IsDate()) return "date";
+  if (value->IsRegExp()) return "regexp";
+  if (value->IsPromise()) return "promise";
+  if (value->IsMap()) return "map";
+  if (value->IsSet()) return "set";
+  if (value->IsNativeError()) return "error";
+  if (value->IsTypedArray()) return "typedarray";
+  if (value->IsArrayBuffer()) return "arraybuffer";
+  return {};
+}
+/** Return primitives without losing undefined, negative zero, nonfinite numbers or bigints. */
+base::Value Describe(v8::Local<v8::Context> context, const std::shared_ptr<Owner>& owner,
+                     v8::Local<v8::Value> value, bool by_value, const std::string& group) {
+  auto* isolate = v8::Isolate::GetCurrent();
+  if (owner->closed) return Failure("Native execution owner was released");
+  if (value->IsUndefined()) return base::Value(base::DictValue().Set("type", "undefined"));
+  if (value->IsNull()) return base::Value(base::DictValue().Set("type", "object").Set("subtype", "null").Set("value", base::Value()));
+  if (value->IsBoolean()) return base::Value(base::DictValue().Set("type", "boolean").Set("value", value->BooleanValue(isolate)));
+  if (value->IsString()) {
+    if (value.As<v8::String>()->Utf8Length(isolate) > static_cast<int>(kTextBytes)) return Failure("Native runtime string limit exceeded");
+    return base::Value(base::DictValue().Set("type", "string").Set("value", String(isolate, value)));
+  }
+  if (value->IsNumber()) {
+    double n = value.As<v8::Number>()->Value();
+    base::DictValue result; result.Set("type", "number");
+    if (std::isnan(n)) result.Set("unserializableValue", "NaN");
+    else if (!std::isfinite(n)) result.Set("unserializableValue", n < 0 ? "-Infinity" : "Infinity");
+    else if (n == 0 && std::signbit(n)) result.Set("unserializableValue", "-0");
+    else result.Set("value", n);
+    return base::Value(std::move(result));
+  }
+  if (value->IsBigInt()) {
+    v8::Local<v8::String> text;
+    if (!value->ToString(context).ToLocal(&text)) return Failure("Cannot serialize bigint");
+    return base::Value(base::DictValue().Set("type", "bigint").Set("unserializableValue", String(isolate, text) + "n"));
+  }
+  base::DictValue result;
+  result.Set("type", value->IsFunction() ? "function" : value->IsSymbol() ? "symbol" : "object");
+  auto subtype = Subtype(value);
+  if (!subtype.empty()) result.Set("subtype", subtype);
+  if (by_value) {
+    v8::Local<v8::String> json;
+    v8::TryCatch caught(isolate);
+    if (!v8::JSON::Stringify(context, value).ToLocal(&json)) return Failure("Object cannot be returned by value");
+    auto bytes = String(isolate, json);
+    auto parsed = base::JSONReader::Read(bytes, base::JSON_PARSE_RFC);
+    if (!parsed) return Failure("Object is not a bounded JSON value");
+    result.Set("value", std::move(*parsed));
+  } else {
+    if (owner->handles.size() >= kHandles) return Failure("Native runtime handle limit exceeded");
+    const auto id = base::UnguessableToken::Create().ToString();
+    owner->handles.emplace(id, StoredValue{v8::Global<v8::Value>(isolate, value), group});
+    result.Set("objectId", id);
+  }
+  return base::Value(std::move(result));
+}
+/** An exception result uses the same renderer-owned object registry as ordinary values. */
+base::Value Exception(v8::Local<v8::Context> context, const std::shared_ptr<Owner>& owner,
+                      v8::Local<v8::Value> error, const std::string& group) {
+  if (error.IsEmpty()) return Failure("Native script execution did not complete");
+  auto remote = Describe(context, owner, error, false, group);
+  if (remote.GetDict().contains("error")) return remote;
+  return base::Value(base::DictValue().Set("result", remote.Clone()).Set("exception",
+      base::DictValue().Set("text", "JavaScript evaluation failed").Set("exception", std::move(remote))));
+}
+/** Descriptor serialization never dereferences a foreign or released object handle. */
+v8::MaybeLocal<v8::Value> Resolve(v8::Isolate* isolate, const std::shared_ptr<Owner>& owner, const std::string& id) {
+  auto found = owner->handles.find(id);
+  if (owner->closed || found == owner->handles.end()) return {};
+  return found->second.value.Get(isolate);
+}
+/** Promise callbacks carry no page-global registry, and close/disconnect cannot resurrect handles. */
+struct Awaited : public std::enable_shared_from_this<Awaited> {
+  std::shared_ptr<Owner> owner;
+  std::string group;
+  bool by_value = false;
+  mojom::OyaRuntime::PerformCallback callback;
+  base::OneShotTimer deadline;
+  void Finish(base::Value result) {
+    auto keep_alive = shared_from_this();
+    deadline.Stop();
+    if (callback) std::move(callback).Run(std::move(result));
+  }
+  void Settle(bool rejected, v8::Local<v8::Value> value) {
+    if (!callback) return;
+    auto context = v8::Isolate::GetCurrent()->GetCurrentContext();
+    if (owner->closed) return Finish(Failure("Native execution owner was released"));
+    if (rejected) return Finish(Exception(context, owner, value, group));
+    auto result = Describe(context, owner, value, by_value, group);
+    if (result.GetDict().contains("error")) return Finish(std::move(result));
+    Finish(base::Value(base::DictValue().Set("result", std::move(result))));
+  }
+};
+/** Waiting has a finite response lifetime; no polling and no alternate execution world. */
+void ReturnValue(v8::Local<v8::Context> context, const std::shared_ptr<Owner>& owner,
+                 const base::DictValue& p, v8::Local<v8::Value> value,
+                 mojom::OyaRuntime::PerformCallback callback) {
+  if (value->IsPromise() && p.FindBool("await").value_or(false)) {
+    auto waiting = std::make_shared<Awaited>();
+    waiting->owner = owner; waiting->group = Param(p, "group");
+    waiting->by_value = p.FindBool("byValue").value_or(false);
+    waiting->callback = std::move(callback);
+    waiting->deadline.Start(FROM_HERE, base::Seconds(10), base::BindOnce(
+      [](std::shared_ptr<Awaited> state) { state->Finish(Failure("Native promise wait timed out")); }, waiting));
+    auto* isolate = v8::Isolate::GetCurrent();
+    auto fulfill = gin_helper::CreateFunctionTemplate(isolate, base::BindRepeating(
+      [](std::shared_ptr<Awaited> state, v8::Local<v8::Value> v) { state->Settle(false, v); }, waiting))->GetFunction(context).ToLocalChecked();
+    auto reject = gin_helper::CreateFunctionTemplate(isolate, base::BindRepeating(
+      [](std::shared_ptr<Awaited> state, v8::Local<v8::Value> v) { state->Settle(true, v); }, waiting))->GetFunction(context).ToLocalChecked();
+    if (value.As<v8::Promise>()->Then(context, fulfill, reject).IsEmpty()) waiting->Finish(Failure("Cannot await native promise"));
+    return;
+  }
+  auto result = Describe(context, owner, value, p.FindBool("byValue").value_or(false), Param(p, "group"));
+  if (result.GetDict().contains("error")) return std::move(callback).Run(std::move(result));
+  std::move(callback).Run(base::Value(base::DictValue().Set("result", std::move(result))));
+}
+/** Only actual JSON values, exact handles and explicit nonfinite primitives become arguments. */
+v8::MaybeLocal<v8::Value> Argument(v8::Local<v8::Context> context, const std::shared_ptr<Owner>& owner, const base::Value& input) {
+  if (!input.is_dict()) return {};
+  const auto& p = input.GetDict(); auto* isolate = v8::Isolate::GetCurrent();
+  if (p.contains("objectId")) return Resolve(isolate, owner, Param(p, "objectId"));
+  if (const auto* value = p.Find("value")) return gin::ConvertToV8(isolate, *value);
+  if (p.contains("special")) {
+    auto text = Param(p, "special");
+    if (text == "NaN") return v8::Number::New(isolate, NAN);
+    if (text == "Infinity") return v8::Number::New(isolate, INFINITY);
+    if (text == "-Infinity") return v8::Number::New(isolate, -INFINITY);
+    if (text == "-0") return v8::Number::New(isolate, -0.0);
+    if (text.empty() || text.back() != 'n') return {};
+    const auto digits = text.substr(text.front() == '-' ? 1 : 0, text.size() - (text.front() == '-' ? 2 : 1));
+    if (digits.empty() || digits.find_first_not_of("0123456789") != std::string::npos) return {};
+    v8::Local<v8::Script> script;
+    if (!v8::Script::Compile(context, Key(isolate, text)).ToLocal(&script)) return {};
+    return script->Run(context);
+  }
+  return v8::Undefined(isolate);
+}
+/** Function execution happens in the real main context, with an exact native receiver. */
+void Invoke(v8::Local<v8::Context> context, const std::shared_ptr<Owner>& owner,
+            const base::DictValue& p, v8::Local<v8::Value> fn, mojom::OyaRuntime::PerformCallback callback) {
+  auto* isolate = v8::Isolate::GetCurrent();
+  if (!fn->IsFunction()) return std::move(callback).Run(Failure("Native callable is not a function"));
+  v8::TryCatch argument_errors(isolate);
+  v8::Local<v8::Value> receiver = context->Global();
+  if (p.contains("receiver") && !Resolve(isolate, owner, Param(p, "receiver")).ToLocal(&receiver))
+    return std::move(callback).Run(Failure("Stale or foreign runtime object"));
+  auto effective = p.Clone();
+  if (p.contains("receiver") && !p.contains("group")) effective.Set("group", owner->handles.at(Param(p, "receiver")).group);
+  std::vector<v8::Local<v8::Value>> arguments;
+  if (const auto* list = p.FindList("arguments")) {
+    if (list->size() > kArguments) return std::move(callback).Run(Failure("Native argument limit exceeded"));
+    for (const auto& item : *list) {
+      v8::Local<v8::Value> value;
+      if (!Argument(context, owner, item).ToLocal(&value)) return std::move(callback).Run(Failure("Invalid or foreign native argument"));
+      arguments.push_back(value);
+    }
+  }
+  v8::TryCatch caught(isolate);
+  v8::Local<v8::Value> result;
+  if (!fn.As<v8::Function>()->Call(context, receiver, arguments.size(), arguments.data()).ToLocal(&result))
+    return std::move(callback).Run(Exception(context, owner, caught.Exception(), Param(effective, "group")));
+  ReturnValue(context, owner, effective, result, std::move(callback));
+}
+/** Enumerate own descriptors only, without invoking getters or proxy traps. */
+base::Value Properties(v8::Local<v8::Context> context, const std::shared_ptr<Owner>& owner, const base::DictValue& p) {
+  auto* isolate = v8::Isolate::GetCurrent(); v8::Local<v8::Value> value;
+  if (!Resolve(isolate, owner, Param(p, "object")).ToLocal(&value)) return Failure("Stale or foreign runtime object");
+  if (!value->IsObject() || value->IsProxy()) return Failure("Native property inspection requires a non-proxy object");
+  const auto group = owner->handles.at(Param(p, "object")).group;
+  v8::TryCatch caught(isolate);
+  auto object = value.As<v8::Object>(); v8::Local<v8::Array> keys;
+  if (!object->GetOwnPropertyNames(context, v8::ALL_PROPERTIES, v8::KeyConversionMode::kConvertToString).ToLocal(&keys))
+    return Failure("Cannot enumerate native properties");
+  if (keys->Length() > kProperties) return Failure("Native property limit exceeded");
+  base::ListValue result;
+  for (uint32_t i = 0; i < keys->Length(); ++i) {
+    v8::Local<v8::Value> key, descriptor;
+    if (!keys->Get(context, i).ToLocal(&key) || !key->IsName() ||
+        !object->GetOwnPropertyDescriptor(context, key.As<v8::Name>()).ToLocal(&descriptor) || !descriptor->IsObject())
+      return Failure("Native property disappeared");
+    auto desc = descriptor.As<v8::Object>();
+    base::DictValue entry;
+    if (key->IsSymbol()) {
+      auto symbol = Describe(context, owner, key, false, group);
+      if (symbol.GetDict().contains("error")) return symbol;
+      entry.Set("symbol", std::move(symbol));
+      entry.Set("name", "Symbol(" + String(isolate, key.As<v8::Symbol>()->Description(isolate)) + ")");
+    } else entry.Set("name", String(isolate, key));
+    entry.Set("isOwn", true);
+    for (const char* flag : {"configurable", "enumerable", "writable"}) {
+      v8::Local<v8::Value> v;
+      if (desc->HasOwnProperty(context, Key(isolate, flag)).FromMaybe(false) &&
+          desc->Get(context, Key(isolate, flag)).ToLocal(&v) && v->IsBoolean()) entry.Set(flag, v->BooleanValue(isolate));
+    }
+    bool accessor = desc->HasOwnProperty(context, Key(isolate, "get")).FromMaybe(false);
+    if (p.FindBool("accessorsOnly").value_or(false) && !accessor) continue;
+    for (const char* field : {"value", "get", "set"}) {
+      if (!desc->HasOwnProperty(context, Key(isolate, field)).FromMaybe(false)) continue;
+      v8::Local<v8::Value> v;
+      if (!desc->Get(context, Key(isolate, field)).ToLocal(&v)) return Failure("Cannot read native descriptor");
+      auto remote = Describe(context, owner, v, false, group);
+      if (remote.GetDict().contains("error")) return remote;
+      entry.Set(field, std::move(remote));
+    }
+    result.Append(std::move(entry));
+  }
+  return base::Value(base::DictValue().Set("properties", std::move(result)));
+}
+}  // namespace
+
+/** Document identity and value owners are native-only; navigating never aliases a previous registry. */
+struct OyaRuntimeState {
+  std::string document = base::UnguessableToken::Create().ToString();
+  std::map<std::string, std::shared_ptr<Owner>> owners;
+};
+OyaRuntime::OyaRuntime(content::RenderFrame* frame) : content::RenderFrameObserver(frame), state_(std::make_shared<OyaRuntimeState>()) {
+  frame->GetAssociatedInterfaceRegistry()->AddInterface<mojom::OyaRuntime>(
+    base::BindRepeating(&OyaRuntime::Bind, weak_factory_.GetWeakPtr()));
+}
+OyaRuntime::~OyaRuntime() { Clear(); }
+void OyaRuntime::OnDestruct() { delete this; }
+void OyaRuntime::Bind(mojo::PendingAssociatedReceiver<mojom::OyaRuntime> receiver) {
+  receiver_.reset(); receiver_.Bind(std::move(receiver));
+}
+void OyaRuntime::Clear() {
+  for (auto& [id, owner] : state_->owners) { owner->closed = true; owner->handles.clear(); }
+  state_ = std::make_shared<OyaRuntimeState>();
+}
+void OyaRuntime::WillReleaseScriptContext(v8::Isolate*, v8::Local<v8::Context>, int32_t world) {
+  if (world == 0) Clear();
+}
+/** Perform fixed native operations; no protocol method names or debugger connection enter the engine. */
+void OyaRuntime::Perform(const std::string& id, const std::string& expected,
+                         const std::string& operation, base::Value parameters, PerformCallback callback) {
+  auto* frame = render_frame()->GetWebFrame();
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::Isolate::Scope isolate_scope(isolate);
+  v8::HandleScope handles(isolate);
+  auto context = frame->MainWorldScriptContext();
+  if (context.IsEmpty() || !render_frame()->GetBlinkPreferences().javascript_enabled)
+    return std::move(callback).Run(Failure("Native main-world context is unavailable"));
+  v8::Context::Scope scope(context);
+  v8::MicrotasksScope microtasks(isolate, context->GetMicrotaskQueue(), v8::MicrotasksScope::kRunMicrotasks);
+  if (operation == "context") return std::move(callback).Run(base::Value(base::DictValue().Set("context", state_->document)));
+  if (expected != state_->document) return std::move(callback).Run(Failure("Native execution context was replaced"));
+  if (id.empty() || id.size() > 128 || !parameters.is_dict()) return std::move(callback).Run(Failure("Invalid native runtime request"));
+  if (operation == "close") {
+    auto owner = state_->owners.find(id);
+    if (owner != state_->owners.end()) { owner->second->closed = true; owner->second->handles.clear(); state_->owners.erase(owner); }
+    return std::move(callback).Run(base::Value(base::DictValue()));
+  }
+  if (!state_->owners.contains(id)) {
+    if (state_->owners.size() >= kOwners) return std::move(callback).Run(Failure("Native runtime owner limit exceeded"));
+    state_->owners[id] = std::make_shared<Owner>();
+  }
+  auto owner = state_->owners[id]; const auto& p = parameters.GetDict();
+  if (operation == "drop") {
+    if (!owner->handles.erase(Param(p, "object"))) return std::move(callback).Run(Failure("Stale or foreign runtime object"));
+    return std::move(callback).Run(base::Value(base::DictValue()));
+  }
+  if (operation == "dropGroup") {
+    for (auto it = owner->handles.begin(); it != owner->handles.end();) {
+      if (it->second.group == Param(p, "group")) it = owner->handles.erase(it); else ++it;
+    }
+    return std::move(callback).Run(base::Value(base::DictValue()));
+  }
+  if (operation == "inspect") return std::move(callback).Run(Properties(context, owner, p));
+  if (operation == "await") {
+    v8::Local<v8::Value> value;
+    if (!Resolve(isolate, owner, Param(p, "object")).ToLocal(&value) || !value->IsPromise())
+      return std::move(callback).Run(Failure("Stale, foreign or non-promise runtime object"));
+    auto effective = p.Clone();
+    if (!p.contains("group")) effective.Set("group", owner->handles.at(Param(p, "object")).group);
+    return ReturnValue(context, owner, effective, value, std::move(callback));
+  }
+  if (operation != "evaluate" && operation != "invoke") return std::move(callback).Run(Failure("Unsupported native runtime operation"));
+  auto code = Param(p, "source");
+  if (code.size() > kTextBytes) return std::move(callback).Run(Failure("Native source limit exceeded"));
+  if (operation == "invoke") code = "(" + code + "\n)";
+  blink::WebScriptSource source(blink::WebString::FromUtf8(code));
+  frame->RequestExecuteScript(0, base::span_from_ref(source),
+      blink::mojom::UserActivationOption::kDoNotActivate,
+      blink::mojom::EvaluationTiming::kSynchronous,
+      blink::mojom::LoadEventBlockingOption::kDoNotBlock, base::NullCallback(),
+      base::BindOnce([](std::shared_ptr<Owner> owner, base::DictValue params,
+                       bool invoke, PerformCallback cb, const std::vector<v8::Local<v8::Value>>& values) {
+        auto* isolate = v8::Isolate::GetCurrent(); auto context = isolate->GetCurrentContext();
+        if (owner->closed) return std::move(cb).Run(Failure("Native execution context was replaced"));
+        if (values.empty() || values[0].IsEmpty())
+          return std::move(cb).Run(Exception(context, owner, v8::Undefined(isolate), Param(params, "group")));
+        if (invoke) return Invoke(context, owner, params, values[0], std::move(cb));
+        ReturnValue(context, owner, params, values[0], std::move(cb));
+      }, owner, p.Clone(), operation == "invoke", std::move(callback)),
+      blink::BackForwardCacheAware::kAllow, blink::mojom::WantResultOption::kWantResult,
+      blink::mojom::PromiseResultOption::kDoNotWait);
+}
