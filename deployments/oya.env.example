# Optional settings for any deployment in this folder. Copy to <deployment>/oya.env,
# uncomment what you need, and deploy again. Every variable is described in
# ENVIRONMENT.md. This file holds secrets: never commit it (oya.env is git-ignored).

# ── LLM for ask() and chat (each API key can also bring its own) ──
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# CHAT_MODEL=gpt-4o-mini
# CHAT_MAX_ITERATIONS=200
# OYA_LLM_TIMEOUT_MS=180000

# ── Operations ──
# OYA_OPERATOR_TOKEN=          # openssl rand -hex 32
# OYA_METRICS_TOKEN=
# OYA_CONSOLE_URL=https://oya.example.com   # the console's public address, for links in Slack

# ── Residential proxy for cloud browsers ──
# OYA_RESIDENTIAL_PROXY_URL=http://user-country-{geo}-session-{session}:pass@gate.vendor.com:7000
# OYA_RESIDENTIAL_PROXY_GEO=US

# ── CAPTCHA solving ──
# OYA_CAPTCHA_PROVIDER=capsolver
# OYA_CAPTCHA_API_KEY=

# ── Personas ──
# OYA_PERSONA_MAX_CONCURRENT=2
# OYA_DEFAULT_PERSONA_MAX_CONCURRENT=

# ── Rate limits and quotas per API key (0 turns a limit off) ──
# OYA_LIMIT_COMMANDS_PER_MIN=600
# OYA_LIMIT_CHAT_PER_MIN=60
# OYA_LIMIT_PROVISION_PER_MIN=20
# OYA_QUOTA_MAX_BROWSERS=5000
# OYA_QUOTA_SANDBOXES_HOUR=500
# OYA_QUOTA_CHAT_TOKENS_HOUR=2000000

# ── Other browser providers ──
# ANCHOR_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# STEEL_API_KEY=
# BROWSERUSE_API_KEY=

# ── Sign-in with Supabase (email, Google, GitHub) ──
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Slack app ──
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# ── Session recording ──
# OYA_RECORD_MAX_FRAMES=1800
# OYA_RECORD_QUALITY=40

# ── Tuning ──
# DATABASE_POOL_MAX=10
