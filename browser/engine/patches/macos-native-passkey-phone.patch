+// Phone availability is opt-in, independent of real credentials or OS dialogs.
+TEST(OyaNativePasskeyPhone, DisabledWithoutOptIn) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->RemoveSwitch("oya-native-passkeys");
+  EXPECT_FALSE(ShouldOfferHybrid(CtapGetAssertionRequest("example.com", "{}")));
+}
+
+// Discoverable credentials can live on a nearby phone.
+TEST(OyaNativePasskeyPhone, DiscoverableRequestAllowsPhone) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("oya-native-passkeys");
+  EXPECT_TRUE(ShouldOfferHybrid(CtapGetAssertionRequest("example.com", "{}")));
+}
+
+// Missing transport hints must not hide a valid phone credential.
+TEST(OyaNativePasskeyPhone, UnspecifiedTransportAllowsPhone) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("oya-native-passkeys");
+  CtapGetAssertionRequest request("example.com", "{}");
+  request.allow_list.emplace_back(CredentialType::kPublicKey,
+                                  std::vector(std::begin(kCredentialID), std::end(kCredentialID)));
+  EXPECT_TRUE(ShouldOfferHybrid(request));
+}
+
+// An explicit hybrid hint is eligible for the native phone option.
+TEST(OyaNativePasskeyPhone, HybridTransportAllowsPhone) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("oya-native-passkeys");
+  CtapGetAssertionRequest request("example.com", "{}");
+  request.allow_list.emplace_back(CredentialType::kPublicKey,
+      std::vector(std::begin(kCredentialID), std::end(kCredentialID)),
+      base::flat_set<FidoTransportProtocol>{FidoTransportProtocol::kHybrid});
+  EXPECT_TRUE(ShouldOfferHybrid(request));
+}
+
+// A request constrained to this device must not offer cross-device sign-in.
+TEST(OyaNativePasskeyPhone, InternalOnlyDoesNotOfferPhone) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("oya-native-passkeys");
+  CtapGetAssertionRequest request("example.com", "{}");
+  request.allow_list.emplace_back(CredentialType::kPublicKey,
+      std::vector(std::begin(kCredentialID), std::end(kCredentialID)),
+      base::flat_set<FidoTransportProtocol>{FidoTransportProtocol::kInternal});
+  EXPECT_FALSE(ShouldOfferHybrid(request));
+}
+
+// A USB-only credential must not be routed to a phone.
+TEST(OyaNativePasskeyPhone, UsbOnlyDoesNotOfferPhone) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch("oya-native-passkeys");
+  CtapGetAssertionRequest request("example.com", "{}");
+  request.allow_list.emplace_back(CredentialType::kPublicKey,
+      std::vector(std::begin(kCredentialID), std::end(kCredentialID)),
+      base::flat_set<FidoTransportProtocol>{FidoTransportProtocol::kUsbHumanInterfaceDevice});
+  EXPECT_FALSE(ShouldOfferHybrid(request));
+}
