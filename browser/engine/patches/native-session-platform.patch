+// This controls the legacy navigator string, not the host operating system.
+void Session::SetOyaPlatform(gin_helper::ErrorThrower thrower,
+                             const std::string& platform) {
+  if (platform != "MacIntel" && platform != "Win32" && platform != "Linux x86_64") {
+    thrower.ThrowTypeError("Invalid native navigator platform");
+    return;
+  }
+  if (!browser_context_->SetOyaPlatform(platform))
+    thrower.ThrowError("Native platform must be installed before any session renderer and cannot be changed");
 }
 
