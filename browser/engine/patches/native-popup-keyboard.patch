+bool WebContents::SendOyaPopupKey(
+    v8::Isolate* isolate,
+    const input::NativeWebKeyboardEvent& event) {
+  auto* host_view = web_contents()->GetRenderWidgetHostView();
+  NSView* view = host_view ? host_view->GetNativeView().GetNativeNSView() : nil;
+  if (!view || ![WebMenuRunner oyaMenuIsRunningForView:view])
+    return false;
+  if (!view.window.isKeyWindow || !IsFocused()) {
+    isolate->ThrowException(v8::Exception::Error(
+        gin::StringToV8(isolate, "Native popup does not own keyboard focus")));
+    return true;
+  }
+  // AppKit derives text from keyDown; the separate renderer char would duplicate it.
+  if (event.GetType() == blink::WebInputEvent::Type::kChar)
+    return true;
+  NSUInteger flags = 0;
+  const int mods = event.GetModifiers();
+  if (mods & blink::WebInputEvent::kShiftKey) flags |= NSEventModifierFlagShift;
+  if (mods & blink::WebInputEvent::kControlKey) flags |= NSEventModifierFlagControl;
+  if (mods & blink::WebInputEvent::kAltKey) flags |= NSEventModifierFlagOption;
+  if (mods & blink::WebInputEvent::kMetaKey) flags |= NSEventModifierFlagCommand;
+  unichar shifted = 0, character = 0;
+  int code = ui::MacKeyCodeForWindowsKeyCode(
+      static_cast<ui::KeyboardCode>(event.windows_key_code), flags,
+      &shifted, &character);
+  if (code < 0) {
+    isolate->ThrowException(v8::Exception::Error(
+        gin::StringToV8(isolate, "Unsupported native popup key")));
+    return true;
+  }
+  const auto type = event.GetType() == blink::WebInputEvent::Type::kKeyUp
+                        ? NSEventTypeKeyUp : NSEventTypeKeyDown;
+  NSEvent* native = [NSEvent keyEventWithType:type
+      location:NSZeroPoint modifierFlags:flags
+      timestamp:NSProcessInfo.processInfo.systemUptime
+      windowNumber:view.window.windowNumber context:nil
+      characters:[NSString stringWithCharacters:&character length:1]
+      charactersIgnoringModifiers:[NSString stringWithCharacters:&shifted length:1]
+      isARepeat:NO keyCode:code];
+  [NSApp postEvent:native atStart:NO];
+  return true;
 }
 
