# Copy to .env. Create an API key in the dashboard at https://oyabrowser.com.
OYA_API_KEY=
# OYA_BASE_URL=http://localhost:3100   # only for a self-hosted server

# Two-factor login (sdk/03-mfa.ts, sdk/demo.ts). These values are a public test account:
# https://authenticationtest.com/totpChallenge/
# TOTP_SECRET=I65VU7K5ZQL7WB4E
# MFA_URL=https://authenticationtest.com/totpChallenge/
# MFA_USER=totp@authenticationtest.com
# MFA_PASSWORD=pa$$w0rd

# Reddit example (playwright/reddit/scrape.ts). Pin a residential proxy to the profile first.
# OYA_PERSONA=default
# OYA_BROWSER_ID=

# Your own AWS account (ecs/). Where the tasks run:
# ECS_CLUSTER=browsers
# ECS_TASK_DEFINITION=oya-browser
# ECS_SUBNETS=subnet-0abc,subnet-0def
# AWS_REGION=us-east-1
# ecs/01-iam.ts:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ecs/02-role.ts:
# ECS_ROLE_ARN=arn:aws:iam::123456789012:role/oya-browsers
# ecs/03-sso.ts:
# AWS_SSO_ACCESS_TOKEN=
# AWS_ACCOUNT_ID=123456789012
# AWS_SSO_ROLE_NAME=PowerUserAccess
